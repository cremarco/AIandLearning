{"version":1,"cues":[{"id":"1","text":"Vadovėlis jau parengtas.","words":[{"from":0,"to":9,"start":0.16,"end":0.58},{"from":10,"to":13,"start":0.58,"end":0.84},{"from":14,"to":24,"start":0.84,"end":0.98}]},{"id":"2","text":"Kodėl renkamės šias priemones?","words":[{"from":0,"to":5,"start":1.92,"end":2.14},{"from":6,"to":14,"start":2.6,"end":2.7},{"from":15,"to":19,"start":2.7,"end":2.94},{"from":20,"to":30,"start":2.94,"end":3.16}]},{"id":"3","text":"ChatGPT, Gemini ir Claude yra alternatyvos\n– galite pasirinkti vieną.","words":[{"from":0,"to":8,"start":4.16,"end":4.92},{"from":9,"to":15,"start":5.06,"end":5.46},{"from":16,"to":18,"start":5.46,"end":5.76},{"from":19,"to":25,"start":5.86,"end":6.26},{"from":26,"to":29,"start":6.34,"end":6.58},{"from":30,"to":42,"start":6.58,"end":7.44},{"from":43,"to":44,"start":7.72,"end":7.82},{"from":45,"to":51,"start":7.82,"end":8.16},{"from":52,"to":62,"start":8.2,"end":8.68},{"from":63,"to":69,"start":8.68,"end":8.8}]},{"id":"4","text":"Gemini Notebook suteikia darbo aplinką\npasirinktiems šaltiniams.","words":[{"from":0,"to":6,"start":9.54,"end":10.06},{"from":7,"to":15,"start":10.06,"end":10.58},{"from":16,"to":24,"start":10.66,"end":11.02},{"from":25,"to":30,"start":11.02,"end":11.46},{"from":31,"to":38,"start":11.5,"end":11.98},{"from":39,"to":52,"start":11.98,"end":12.68},{"from":53,"to":64,"start":12.68,"end":13.76}]},{"id":"5","text":"Mokamos prieigos prie visų jų nereikia.","words":[{"from":0,"to":7,"start":13.76,"end":14.12},{"from":8,"to":16,"start":14.22,"end":14.52},{"from":17,"to":21,"start":14.52,"end":14.86},{"from":22,"to":26,"start":15.06,"end":15.24},{"from":27,"to":29,"start":15.24,"end":15.44},{"from":30,"to":39,"start":15.44,"end":15.8}]},{"id":"6","text":"Šie keturi aspektai leidžia palyginti tokį\nmetodą su atskiroms mokymosi užduotims","words":[{"from":0,"to":3,"start":17.22,"end":17.32},{"from":4,"to":10,"start":17.32,"end":17.62},{"from":11,"to":19,"start":17.62,"end":18.24},{"from":20,"to":27,"start":18.32,"end":18.6},{"from":28,"to":37,"start":18.6,"end":19.14},{"from":38,"to":42,"start":19.14,"end":19.5},{"from":43,"to":49,"start":19.5,"end":20},{"from":50,"to":52,"start":20,"end":20.24},{"from":53,"to":62,"start":20.24,"end":20.84},{"from":63,"to":71,"start":20.84,"end":21.62},{"from":72,"to":81,"start":21.62,"end":22.02}]},{"id":"7","text":"skirtomis priemonėmis.","words":[{"from":0,"to":9,"start":22.36,"end":22.54},{"from":10,"to":22,"start":22.54,"end":22.9}]},{"id":"8","text":"Pirma, jos suteikia daugiau kontrolės.","words":[{"from":0,"to":6,"start":24.16,"end":24.8},{"from":7,"to":10,"start":24.94,"end":25.02},{"from":11,"to":19,"start":25.02,"end":25.5},{"from":20,"to":27,"start":25.5,"end":25.86},{"from":28,"to":38,"start":25.86,"end":27.06}]},{"id":"9","text":"Pagal savo tikslą galime paprašyti\npaprastesnio paaiškinimo arba vieno","words":[{"from":0,"to":5,"start":27.06,"end":27.18},{"from":6,"to":10,"start":27.18,"end":27.44},{"from":11,"to":17,"start":27.44,"end":27.9},{"from":18,"to":24,"start":27.96,"end":28.28},{"from":25,"to":34,"start":28.28,"end":28.88},{"from":35,"to":47,"start":29.08,"end":29.62},{"from":48,"to":59,"start":30.06,"end":30.34},{"from":60,"to":64,"start":30.34,"end":30.74},{"from":65,"to":70,"start":30.74,"end":31.16}]},{"id":"10","text":"klausimo vienu metu. Antra, galime\nsujungti mokymosi užduotis.","words":[{"from":0,"to":8,"start":31.24,"end":31.72},{"from":9,"to":14,"start":31.72,"end":32.1},{"from":15,"to":20,"start":32.1,"end":33.54},{"from":21,"to":27,"start":33.54,"end":34.08},{"from":28,"to":34,"start":34.24,"end":34.32},{"from":35,"to":43,"start":34.32,"end":34.84},{"from":44,"to":52,"start":34.84,"end":35.5},{"from":53,"to":62,"start":35.5,"end":36.5}]},{"id":"11","text":"Tą patį vadovėlį galime naudoti\npaaiškinimams, schemoms ir praktikai,","words":[{"from":0,"to":2,"start":36.5,"end":36.58},{"from":3,"to":7,"start":36.58,"end":36.84},{"from":8,"to":16,"start":36.84,"end":37.38},{"from":17,"to":23,"start":37.38,"end":37.8},{"from":24,"to":31,"start":37.8,"end":38.24},{"from":32,"to":46,"start":38.24,"end":39.1},{"from":47,"to":55,"start":39.44,"end":39.8},{"from":56,"to":58,"start":39.8,"end":40.06},{"from":59,"to":69,"start":40.06,"end":40.26}]},{"id":"12","text":"tikrindami kiekvieną rezultatą.","words":[{"from":0,"to":10,"start":41.02,"end":41.4},{"from":11,"to":20,"start":41.4,"end":41.98},{"from":21,"to":31,"start":41.98,"end":43.68}]},{"id":"13","text":"Trečia, laviname kitur pritaikomus\nįgūdžius.","words":[{"from":0,"to":7,"start":43.76,"end":44.14},{"from":8,"to":16,"start":44.5,"end":44.78},{"from":17,"to":22,"start":44.78,"end":45.2},{"from":23,"to":34,"start":45.2,"end":45.9},{"from":35,"to":44,"start":45.9,"end":46.96}]},{"id":"14","text":"Tikslų nustatymas ir atsakymų tikrinimas\npadeda ir kituose dalykuose.","words":[{"from":0,"to":6,"start":47.1,"end":47.26},{"from":7,"to":17,"start":47.26,"end":47.88},{"from":18,"to":20,"start":47.88,"end":48.14},{"from":21,"to":29,"start":48.14,"end":48.64},{"from":30,"to":40,"start":48.64,"end":49.24},{"from":41,"to":47,"start":49.38,"end":49.72},{"from":48,"to":50,"start":49.92,"end":50.02},{"from":51,"to":58,"start":50.02,"end":50.42},{"from":59,"to":69,"start":50.42,"end":50.52}]},{"id":"15","text":"Galiausiai galime sutaupyti. Vienas\nasistentas gali patenkinti kelis","words":[{"from":0,"to":10,"start":52.42,"end":52.52},{"from":11,"to":17,"start":52.52,"end":52.94},{"from":18,"to":28,"start":52.94,"end":54.06},{"from":29,"to":35,"start":54.28,"end":54.36},{"from":36,"to":46,"start":54.36,"end":55.04},{"from":47,"to":51,"start":55.04,"end":55.34},{"from":52,"to":62,"start":55.34,"end":55.96},{"from":63,"to":68,"start":55.96,"end":56.36}]},{"id":"16","text":"poreikius,","words":[{"from":0,"to":10,"start":56.36,"end":56.46}]},{"id":"17","text":"nors nemokama prieiga turi ribojimų.","words":[{"from":0,"to":4,"start":57.34,"end":57.42},{"from":5,"to":13,"start":57.42,"end":57.98},{"from":14,"to":21,"start":57.98,"end":58.44},{"from":22,"to":26,"start":58.44,"end":58.78},{"from":27,"to":36,"start":58.78,"end":59.16}]},{"id":"18","text":"Prireikus galime pridėti specializuotą\npriemonę.","words":[{"from":0,"to":9,"start":59.78,"end":60.32},{"from":10,"to":16,"start":60.36,"end":60.72},{"from":17,"to":24,"start":60.74,"end":61.14},{"from":25,"to":38,"start":61.22,"end":61.98},{"from":39,"to":48,"start":61.98,"end":62.94}]},{"id":"19","text":"Pradėkime nuo ChatGPT.","words":[{"from":0,"to":9,"start":62.98,"end":63.4},{"from":10,"to":13,"start":63.4,"end":63.62},{"from":14,"to":22,"start":63.62,"end":64.1}]}]}
