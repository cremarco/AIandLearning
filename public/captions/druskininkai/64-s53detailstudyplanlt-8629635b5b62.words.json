{"version":1,"cues":[{"id":"1","text":"Atsakymai padeda Andrea nuspręsti, ko\nmokytis toliau.","words":[{"from":0,"to":9,"start":0.12,"end":0.72},{"from":10,"to":16,"start":0.76,"end":1.12},{"from":17,"to":23,"start":1.12,"end":1.48},{"from":24,"to":34,"start":1.48,"end":2.5},{"from":35,"to":37,"start":2.5,"end":2.58},{"from":38,"to":45,"start":2.58,"end":3.18},{"from":46,"to":53,"start":3.18,"end":3.4}]},{"id":"2","text":"Šis planas suskaido tikslą į mažesnes\nveiklas.","words":[{"from":0,"to":3,"start":4.44,"end":4.58},{"from":4,"to":10,"start":4.64,"end":5.08},{"from":11,"to":19,"start":5.28,"end":5.56},{"from":20,"to":26,"start":5.56,"end":6.1},{"from":27,"to":28,"start":6.1,"end":6.22},{"from":29,"to":37,"start":6.22,"end":6.8},{"from":38,"to":46,"start":6.8,"end":6.94}]},{"id":"3","text":"Jis gali pažymėti pažangą ir pereiti tarp\nžingsnių.","words":[{"from":0,"to":3,"start":7.84,"end":7.88},{"from":4,"to":8,"start":7.88,"end":8.14},{"from":9,"to":17,"start":8.14,"end":8.68},{"from":18,"to":25,"start":8.88,"end":9.36},{"from":26,"to":28,"start":9.42,"end":9.62},{"from":29,"to":36,"start":9.7,"end":10.12},{"from":37,"to":41,"start":10.12,"end":10.34},{"from":42,"to":51,"start":10.34,"end":10.44}]},{"id":"4","text":"Po kiekvienos veiklos pasitikrina, ką gali\npaaiškinti arba atlikti pats.","words":[{"from":0,"to":2,"start":11.38,"end":11.5},{"from":3,"to":13,"start":11.5,"end":11.96},{"from":14,"to":21,"start":11.96,"end":12.5},{"from":22,"to":34,"start":12.5,"end":13.3},{"from":35,"to":37,"start":13.52,"end":13.62},{"from":38,"to":42,"start":13.62,"end":13.94},{"from":43,"to":53,"start":13.96,"end":14.76},{"from":54,"to":58,"start":14.78,"end":15.12},{"from":59,"to":66,"start":15.12,"end":15.58},{"from":67,"to":72,"start":15.58,"end":15.76}]}]}
