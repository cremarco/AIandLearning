{"version":1,"cues":[{"id":"1","text":"Taip pat galime pakeisti pokalbio eigą.","words":[{"from":0,"to":4,"start":0.2,"end":0.28},{"from":5,"to":8,"start":0.28,"end":0.42},{"from":9,"to":15,"start":0.42,"end":0.86},{"from":16,"to":24,"start":1.06,"end":1.36},{"from":25,"to":33,"start":1.44,"end":1.96},{"from":34,"to":39,"start":1.96,"end":3.52}]},{"id":"2","text":"Learning Guide yra Gemini Notebook\npokalbio režimas,","words":[{"from":0,"to":8,"start":3.76,"end":3.76},{"from":9,"to":14,"start":3.76,"end":4.18},{"from":15,"to":18,"start":4.18,"end":4.48},{"from":19,"to":25,"start":4.48,"end":4.98},{"from":26,"to":34,"start":4.98,"end":5.5},{"from":35,"to":43,"start":5.54,"end":6.04},{"from":44,"to":52,"start":6.04,"end":6.34}]},{"id":"3","text":"skirtas mokytis pagal savo šaltinius.","words":[{"from":0,"to":7,"start":7.1,"end":7.2},{"from":8,"to":15,"start":7.2,"end":7.72},{"from":16,"to":21,"start":7.78,"end":8.04},{"from":22,"to":26,"start":8.04,"end":8.32},{"from":27,"to":37,"start":8.32,"end":9.66}]},{"id":"4","text":"Jis užduoda atvirus klausimus, suskaido\nproblemas į mažesnius žingsnius ir","words":[{"from":0,"to":3,"start":9.72,"end":9.78},{"from":4,"to":11,"start":9.78,"end":10.22},{"from":12,"to":19,"start":10.22,"end":10.72},{"from":20,"to":30,"start":10.72,"end":11.38},{"from":31,"to":39,"start":11.74,"end":12.12},{"from":40,"to":49,"start":12.12,"end":12.66},{"from":50,"to":51,"start":12.74,"end":12.86},{"from":52,"to":61,"start":12.86,"end":13.3},{"from":62,"to":71,"start":13.3,"end":13.8},{"from":72,"to":74,"start":13.8,"end":14.28}]},{"id":"5","text":"pritaiko paaiškinimus besimokančiajam.","words":[{"from":0,"to":8,"start":14.28,"end":14.8},{"from":9,"to":21,"start":14.8,"end":15.54},{"from":22,"to":38,"start":15.54,"end":17.18}]},{"id":"6","text":"Pasirenkame šį režimą ir nustatome\natsakymo ilgį, kad Andrea turėtų erdvės","words":[{"from":0,"to":11,"start":17.2,"end":17.68},{"from":12,"to":14,"start":17.68,"end":17.9},{"from":15,"to":21,"start":17.