{"version":1,"cues":[{"id":"1","text":"Šis žemėlapis sukurtas naudojant Mind Map.","words":[{"from":0,"to":3,"start":0.08,"end":0.3},{"from":4,"to":13,"start":0.3,"end":0.86},{"from":14,"to":22,"start":1.04,"end":1.4},{"from":23,"to":32,"start":1.88,"end":1.98},{"from":33,"to":37,"start":1.98,"end":2.4},{"from":38,"to":42,"start":2.4,"end":3.78}]},{"id":"2","text":"Jis susieja pagrindines sąvokas.","words":[{"from":0,"to":3,"start":3.78,"end":3.86},{"from":4,"to":11,"start":3.86,"end":4.34},{"from":12,"to":23,"start":4.34,"end":4.98},{"from":24,"to":32,"start":4.98,"end":6.18}]},{"id":"3","text":"Galime padidinti vaizdą ir perskaityti\nkiekvieną šaką.","words":[{"from":0,"to":6,"start":6.28,"end":6.5},{"from":7,"to":16,"start":6.5,"end":7.1},{"from":17,"to":23,"start":7.1,"end":7.6},{"from":24,"to":26,"start":7.62,"end":7.84},{"from":27,"to":38,"start":7.86,"end":8.52},{"from":39,"to":48,"start":8.58,"end":9.08},{"from":49,"to":54,"start":9.08,"end":9.22}]},{"id":"4","text":"Kur keičiasi parametrai, o kur informacija\npridedama kaip įvestis?","words":[{"from":0,"to":3,"start":10.24,"end":10.34},{"from":4,"to":12,"start":10.34,"end":10.92},{"from":13,"to":24,"start":10.92,"end":11.84},{"from":25,"to":26,"start":11.88,"end":12.06},{"from":27,"to":30,"start":12.18,"end":12.34},{"from":31,"to":42,"start":12.34,"end":12.98},{"from":43,"to":52,"start":12.98,"end":13.52},{"from":53,"to":57,"start":13.74,"end":13.84},{"from":58,"to":66,"start":13.84,"end":15.2}]},{"id":"5","text":"Andrea patikrina ryšius pagal vadovėlį ir\ntada juos paaiškina be žemėlapio.","words":[{"from":0,"to":6,"start":15.2,"end":15.38},{"from":7,"to":16,"start":15.38,"end":15.92},{"from":17,"to":23,"start":15.92,"end":16.4},{"from":24,"to":29,"start":16.44,"end":16.7},{"from":30,"to":38,"start":16.7,"end":17.34},{"from":39,"to":41,"start":17.34,"end":17.7},{"from":42,"to":46,"start":17.74,"end":17.96},{"from":47,"to":51,"start":17.96,"end":18.22},{"from":52,"to":61,"start":18.26,"end":18.78},{"from":6