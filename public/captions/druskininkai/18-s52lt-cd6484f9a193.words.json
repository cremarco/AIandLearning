{"version":1,"cues":[{"id":"1","text":"Andrea turi suprasti vadovėlį ir parodyti,\nką išmoko.","words":[{"from":0,"to":6,"start":0.42,"end":0.42},{"from":7,"to":11,"start":0.42,"end":0.74},{"from":12,"to":20,"start":0.74,"end":1.22},{"from":21,"to":29,"start":1.22,"end":1.84},{"from":30,"to":32,"start":1.84,"end":2.18},{"from":33,"to":42,"start":2.18,"end":2.64},{"from":43,"to":45,"start":2.9,"end":3.04},{"from":46,"to":53,"start":3.04,"end":4.48}]},{"id":"2","text":"Stebėsime keturias susijusias veiklas.","words":[{"from":0,"to":9,"start":4.48,"end":4.92},{"from":10,"to":18,"start":4.92,"end":5.52},{"from":19,"to":29,"start":5.72,"end":6.16},{"from":30,"to":38,"start":6.16,"end":7.38}]},{"id":"3","text":"Pirmiausia jis skaito vadovėlį ir\npasižymi, kas neaišku.","words":[{"from":0,"to":10,"start":7.38,"end":7.9},{"from":11,"to":14,"start":7.96,"end":8.18},{"from":15,"to":21,"start":8.24,"end":8.48},{"from":22,"to":30,"start":8.48,"end":9.14},{"from":31,"to":33,"start":9.14,"end":9.38},{"from":34,"to":43,"start":9.38,"end":10.16},{"from":44,"to":47,"start":10.22,"end":10.26},{"from":48,"to":56,"start":10.26,"end":10.5}]},{"id":"4","text":"Tada jis pavaizduoja idėjas schemoje ir\npaaiškina jų ryšius.","words":[{"from":0,"to":4,"start":11.7,"end":11.7},{"from":5,"to":8,"start":12.02,"end":12.12},{"from":9,"to":20,"start":12.12,"end":12.74},{"from":21,"to":27,"start":12.74,"end":13.24},{"from":28,"to":36,"start":13.24,"end":13.86},{"from":37,"to":39,"start":13.94,"end":14.12},{"from":40,"to":49,"start":14.2,"end":14.68},{"from":50,"to":52,"start":14.68,"end":14.98},{"from":53,"to":60,"start":14.98,"end":15.08}]},{"id":"5","text":"Toliau jis tikrina schemą ir DI pasiūlymus\npagal vadovėlį bei ištaiso klaidas.","words":[{"from":0,"to":6,"start":15.98,"end":16.16},{"from":7,"to":10,"start":16.16,"end":16.4},{"from":11,"to":18,"start":16.64,"end":16.78},{"from":19,"to":25,"start":16.78,"end":17.38},{"from":26,"to":28,"start":17.46,"end":17.66},{"from":29,"to":31,"start":17.66,"end":18},{"from":32,"to":42,"start":18,"end":18.64},{"from":43,"to":48,"start":18.64,"end":19},{"from":49,"to":57,"start":19,"end":19.64},{"from":58,"to":61,"start":19.68,"end":19.94},{"from":62,"to":69,"start":19.94,"end":20.46},{"from":70,"to":78,"start":20.46,"end":21.56}]},{"id":"6","text":"Galiausiai jis paaiškina naują pavyzdį\nsavais žodžiais,","words":[{"from":0,"to":10,"start":22.08,"end":22.18},{"from":11,"to":14,"start":22.18,"end":22.36},{"from":15,"to":24,"start":22.4,"end":22.9},{"from":25,"to":30,"start":22.9,"end":23.3},{"from":31,"to":38,"start":23.3,"end":23.84},{"from":39,"to":45,"start":23.84,"end":24.24},{"from":46,"to":55,"start":24.24,"end":24.34}]},{"id":"7","text":"be DI. Jo schema, paaiškinimas ir\npataisymai parodo, ką jis supranta.","words":[{"from":0,"to":2,"start":25.16,"end":25.16},{"from":3,"to":6,"start":25.16,"end":26.16},{"from":7,"to":9,"start":26.22,"end":26.22},{"from":10,"to":17,"start":26.22,"end":26.92},{"from":18,"to":30,"start":26.96,"end":27.62},{"from":31,"to":33,"start":27.62,"end":27.84},{"from":34,"to":44,"start":27.88,"end":28.52},{"from":45,"to":52,"start":28.52,"end":29.28},{"from":53,"to":55,"start":29.34,"end":29.42},{"from":56,"to":59,"start":29.44,"end":29.58},{"from":60,"to":69,"start":29.58,"end":29.68}]}]}
