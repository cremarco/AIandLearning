{"version":1,"cues":[{"id":"1","text":"Norėdamas patikrinti atsakymą, Andrea\natveria citatą ir perskaito ištrauką.","words":[{"from":0,"to":9,"start":0.56,"end":0.66},{"from":10,"to":20,"start":0.66,"end":1.26},{"from":21,"to":30,"start":1.26,"end":2.26},{"from":31,"to":37,"start":2.54,"end":2.56},{"from":38,"to":45,"start":2.56,"end":3.04},{"from":46,"to":52,"start":3.04,"end":3.72},{"from":53,"to":55,"start":3.72,"end":3.92},{"from":56,"to":65,"start":3.96,"end":4.58},{"from":66,"to":75,"start":4.58,"end":4.72}]},{"id":"2","text":"Čia svarbūs žodžiai įprastas išvedimas:\njie apibūdina sąlygas, kuriomis modelio","words":[{"from":0,"to":3,"start":6.04,"end":6.16},{"from":4,"to":11,"start":6.16,"end":6.62},{"from":12,"to":19,"start":6.62,"end":7.08},{"from":20,"to":28,"start":7.1,"end":7.6},{"from":29,"to":39,"start":7.6,"end":8.78},{"from":40,"to":43,"start":8.86,"end":8.96},{"from":44,"to":53,"start":9.1,"end":9.6},{"from":54,"to":62,"start":9.6,"end":10.36},{"from":63,"to":71,"start":10.36,"end":10.78},{"from":72,"to":79,"start":10.78,"end":11.2}]},{"id":"3","text":"parametrai lieka fiksuoti. Jis tikrina, ar\ništrauka pagrindžia tikslų atsakyme","words":[{"from":0,"to":10,"start":11.24,"end":11.82},{"from":11,"to":16,"start":11.82,"end":12.16},{"from":17,"to":26,"start":12.16,"end":13.34},{"from":27,"to":30,"start":13.44,"end":13.54},{"from":31,"to":39,"start":13.54,"end":14.14},{"from":40,"to":42,"start":14.26,"end":14.42},{"from":43,"to":51,"start":14.64,"end":14.94},{"from":52,"to":62,"start":14.98,"end":15.5},{"from":63,"to":69,"start":15.5,"end":15.98},{"from":70,"to":78,"start":15.98,"end":16.56}]},{"id":"4","text":"pateiktą teiginį.","words":[{"from":0,"to":8,"start":16.6,"end":17.1},{"from":9,"to":17,"start":17.1,"end":17.38}]}]}
