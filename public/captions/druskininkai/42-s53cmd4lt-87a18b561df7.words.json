{"version":1,"cues":[{"id":"1","text":"Šioms veikloms taip pat reikia plano.","words":[{"from":0,"to":5,"start":0.14,"end":0.4},{"from":6,"to":14,"start":0.4,"end":0.98},{"from":15,"to":19,"start":1.08,"end":1.34},{"from":20,"to":23,"start":1.34,"end":1.58},{"from":24,"to":30,"start":1.8,"end":1.9},{"from":31,"to":37,"start":1.9,"end":2.02}]},{"id":"2","text":"Andrea gali naudoti /studyplan tolesniems\nžingsniams pasirinkti.","words":[{"from":0,"to":6,"start":3.36,"end":3.36},{"from":7,"to":11,"start":3.36,"end":3.7},{"from":12,"to":19,"start":3.7,"end":4.18},{"from":20,"to":30,"start":4.22,"end":6.34},{"from":31,"to":41,"start":6.34,"end":6.98},{"from":42,"to":52,"start":6.98,"end":7.64},{"from":53,"to":64,"start":7.64,"end":7.98}]},{"id":"3","text":"Mokytojai gali planuoti pamoką, pritaikyti\npagalbos lygį arba sukurti mokymosi","words":[{"from":0,"to":9,"start":8.72,"end":9.36},{"from":10,"to":14,"start":9.36,"end":9.68},{"from":15,"to":23,"start":9.68,"end":10.2},{"from":24,"to":31,"start":10.2,"end":10.82},{"from":32,"to":42,"start":11.02,"end":11.58},{"from":43,"to":51,"start":11.68,"end":12.08},{"from":52,"to":56,"start":12.16,"end":12.56},{"from":57,"to":61,"start":12.66,"end":12.98},{"from":62,"to":69,"start":13.16,"end":13.5},{"from":70,"to":78,"start":14.02,"end":14.12}]},{"id":"4","text":"stoteles. Bendri kriterijai gali padėti\nteikti grįžtamąjį ryšį vieni kitiems.","words":[{"from":0,"to":9,"start":14.12,"end":15.18},{"from":10,"to":16,"start":15.28,"end":15.6},{"from":17,"to":27,"start":15.6,"end":16.28},{"from":28,"to":32,"start":16.28,"end":16.6},{"from":33,"to":39,"start":16.62,"end":17.04},{"from":40,"to":46,"start":17.04,"end":17.46},{"from":47,"to":57,"start":17.46,"end":18.24},{"from":58,"to":62,"start":18.24,"end":18.64},{"from":63,"to":68,"start":18.64,"end":18.94},{"from":69,"to":77,"start":18.94,"end":20.02}]},{"id":"5","text":"Dabar peržiūrėsime po vieną kiekvienos\ngrupės pavyzdį.","words":[{"from":0,"to":5,"start":20.04,"end":20.3},{"fro