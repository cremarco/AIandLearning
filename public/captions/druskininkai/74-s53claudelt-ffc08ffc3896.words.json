{"version":1,"cues":[{"id":"1","text":"Ar šias užklausas galime naudoti su kitu\nasistentu?","words":[{"from":0,"to":2,"start":0.24,"end":0.24},{"from":3,"to":7,"start":0.24,"end":0.6},{"from":8,"to":17,"start":0.62,"end":1.3},{"from":18,"to":24,"start":1.3,"end":1.7},{"from":25,"to":32,"start":1.7,"end":2.1},{"from":33,"to":35,"start":2.1,"end":2.32},{"from":36,"to":40,"start":2.34,"end":2.58},{"from":41,"to":51,"start":2.58,"end":4.44}]},{"id":"2","text":"Naudojant Claude, tas pats vadovėlis ir\nužklausos leido gauti penkis veikiančius","words":[{"from":0,"to":9,"start":4.44,"end":4.88},{"from":10,"to":17,"start":4.88,"end":5.3},{"from":18,"to":21,"start":5.6,"end":5.76},{"from":22,"to":26,"start":5.82,"end":6.02},{"from":27,"to":36,"start":6.02,"end":6.68},{"from":37,"to":39,"start":6.72,"end":6.88},{"from":40,"to":49,"start":6.88,"end":7.56},{"from":50,"to":55,"start":7.56,"end":7.88},{"from":56,"to":61,"start":7.88,"end":8.28},{"from":62,"to":68,"start":8.32,"end":8.84},{"from":69,"to":80,"start":8.84,"end":9.38}]},{"id":"3","text":"pavyzdžius:","words":[{"from":0,"to":11,"start":9.38,"end":9.62}]},{"id":"4","text":"korteles, testą, žodinę praktiką, klaidų\nžurnalą ir sąvokų žemėlapį.","words":[{"from":0,"to":9,"start":10.64,"end":10.86},{"from":10,"to":16,"start":11.4,"end":12.04},{"from":17,"to":23,"start":12.16,"end":12.5},{"from":24,"to":33,"start":12.5,"end":13.12},{"from":34,"to":40,"start":13.52,"end":13.78},{"from":41,"to":48,"start":13.78,"end":14.38},{"from":49,"to":51,"start":14.38,"end":14.7},{"from":52,"to":58,"start":14.82,"end":15.22},{"from":59,"to":68,"start":15.22,"end":15.66}]},{"id":"5","text":"Sąsaja keičiasi, bet užduotis lieka ta\npati.","words":[{"from":0,"to":6,"start":16.76,"end":17.14},{"from":7,"to":16,"start":17.14,"end":17.58},{"from":17,"to":20,"start":18.14,"end":18.24},{"from":21,"to":29,"start":18.28,"end":18.94},{"from":30,"to":35,"start":18.94,"end":19.28},{"from":36,"to":38,"start":19.28,"end":19.46},{"from":39,"to":44,"star