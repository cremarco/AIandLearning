{"version":1,"cues":[{"id":"1","text":"Testas suteikia dar vieną greitą būdą\npasitikrinti.","words":[{"from":0,"to":6,"start":0.08,"end":0.48},{"from":7,"to":15,"start":0.48,"end":0.98},{"from":16,"to":19,"start":0.98,"end":1.3},{"from":20,"to":25,"start":1.3,"end":1.62},{"from":26,"to":32,"start":1.62,"end":2.02},{"from":33,"to":37,"start":2.02,"end":2.34},{"from":38,"to":51,"start":2.34,"end":4.3}]},{"id":"2","text":"Andrea pasirenka atsakymą prieš\nskaitydamas grįžtamąjį ryšį.","words":[{"from":0,"to":6,"start":4.5,"end":4.5},{"from":7,"to":16,"start":4.5,"end":5.12},{"from":17,"to":25,"start":5.12,"end":5.76},{"from":26,"to":31,"start":5.88,"end":6.26},{"from":32,"to":43,"start":6.3,"end":6.88},{"from":44,"to":54,"start":6.92,"end":7.56},{"from":55,"to":60,"start":7.56,"end":8.72}]},{"id":"3","text":"Jei suklysta, pasinaudoja paaiškinimu, kad\npasitaisytų.","words":[{"from":0,"to":3,"start":8.72,"end":8.88},{"from":4,"to":13,"start":8.88,"end":9.72},{"from":14,"to":25,"start":9.72,"end":10.36},{"from":26,"to":38,"start":10.36,"end":11.12},{"from":39,"to":42,"start":11.36,"end":11.36},{"from":43,"to":55,"start":11.36,"end":12.84}]},{"id":"4","text":"Naudingas klausimas:","words":[{"from":0,"to":9,"start":12.86,"end":13.26},{"from":10,"to":20,"start":13.26,"end":13.5}]},{"id":"5","text":"kodėl pataisytas atsakymas yra teisingas?","words":[{"from":0,"to":5,"start":14.32,"end":14.56},{"from":6,"to":16,"start":14.56,"end":15.28},{"from":17,"to":26,"start":15.42,"end":15.9},{"from":27,"to":30,"start":15.9,"end":16.2},{"from":31,"to":41,"start":16.2,"end":16.76}]}]}
