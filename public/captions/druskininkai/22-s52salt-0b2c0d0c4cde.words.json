{"version":1,"cues":[{"id":"1","text":"Tačiau kaip Andrea sužino, ar jo\npasirinkimai veiksmingi?","words":[{"from":0,"to":6,"start":0.08,"end":0.48},{"from":7,"to":11,"start":0.48,"end":0.86},{"from":12,"to":18,"start":0.86,"end":1.18},{"from":19,"to":26,"start":1.18,"end":2.16},{"from":27,"to":29,"start":2.16,"end":2.24},{"from":30,"to":32,"start":2.24,"end":2.4},{"from":33,"to":45,"start":2.4,"end":3.14},{"from":46,"to":57,"start":3.14,"end":4.56}]},{"id":"2","text":"Per įsivertinimą: jis tikrina savo darbą\npagal aiškius kriterijus.","words":[{"from":0,"to":3,"start":4.56,"end":4.62},{"from":4,"to":17,"start":4.62,"end":5.94},{"from":18,"to":21,"start":5.98,"end":6.04},{"from":22,"to":29,"start":6.04,"end":6.5},{"from":30,"to":34,"start":6.5,"end":6.82},{"from":35,"to":40,"start":7.18,"end":7.28},{"from":41,"to":46,"start":7.28,"end":7.62},{"from":47,"to":54,"start":7.62,"end":8.1},{"from":55,"to":66,"start":8.1,"end":9.32}]},{"id":"3","text":"Pavyzdžiui,","words":[{"from":0,"to":11,"start":9.32,"end":9.42}]},{"id":"4","text":"jis gali paaiškinti idėjas, bet jam sunku\natskleisti jų ryšius, todėl jis patobulina","words":[{"from":0,"to":3,"start":10.16,"end":10.24},{"from":4,"to":8,"start":10.24,"end":10.52},{"from":9,"to":19,"start":10.52,"end":11.14},{"from":20,"to":27,"start":11.14,"end":11.58},{"from":28,"to":31,"start":11.94,"end":11.98},{"from":32,"to":35,"start":12,"end":12.2},{"from":36,"to":41,"start":12.32,"end":12.66},{"from":42,"to":52,"start":12.66,"end":13.22},{"from":53,"to":55,"start":13.22,"end":13.48},{"from":56,"to":63,"start":13.48,"end":13.82},{"from":64,"to":69,"start":14.3,"end":14.5},{"from":70,"to":73,"start":14.5,"end":14.68},{"from":74,"to":84,"start":14.7,"end":15.34}]},{"id":"5","text":"savo žemėlapį. DI gali pateikti grįžtamąjį\nryšį, tačiau Andrea nusprendžia, ką","words":[{"from":0,"to":4,"start":15.34,"end":15.62},{"from":5,"to":14,"start":15.62,"end":16.78},{"from":15,"to":17,"start":16.8,"end":17.24},{"from":18,"to":22,"start":1