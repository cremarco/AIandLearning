{"version":1,"cues":[{"id":"1","text":"Dabar panagrinėkime 15 užklausų pavyzdžių.","words":[{"from":0,"to":5,"start":0.2,"end":0.38},{"from":6,"to":19,"start":0.38,"end":1.26},{"from":20,"to":22,"start":1.32,"end":1.98},{"from":23,"to":31,"start":1.98,"end":2.66},{"from":32,"to":42,"start":2.66,"end":3.72}]},{"id":"2","text":"Kiekvienas jų padeda atlikti mokymosi\nveiksmą, pavyzdžiui, prisiminti,","words":[{"from":0,"to":10,"start":3.72,"end":4.2},{"from":11,"to":13,"start":4.24,"end":4.44},{"from":14,"to":20,"start":4.44,"end":4.84},{"from":21,"to":28,"start":4.84,"end":5.3},{"from":29,"to":37,"start":5.3,"end":5.94},{"from":38,"to":46,"start":5.94,"end":6.06},{"from":47,"to":58,"start":6.62,"end":7.38},{"from":59,"to":70,"start":7.38,"end":8.02}]},{"id":"3","text":"paaiškinti ar planuoti.","words":[{"from":0,"to":10,"start":8.44,"end":8.96},{"from":11,"to":13,"start":9.02,"end":9.2},{"from":14,"to":23,"start":9.2,"end":9.54}]},{"id":"4","text":"Galite pasirinkti žymenį, perskaityti jo\npaskirtį ir atverti įrašą.","words":[{"from":0,"to":6,"start":11.02,"end":11.3},{"from":7,"to":17,"start":11.3,"end":11.9},{"from":18,"to":25,"start":11.9,"end":12.7},{"from":26,"to":37,"start":13.2,"end":13.3},{"from":38,"to":40,"start":13.3,"end":13.5},{"from":41,"to":49,"start":13.56,"end":14.18},{"from":50,"to":52,"start":14.28,"end":14.5},{"from":53,"to":60,"start":14.68,"end":15.06},{"from":61,"to":67,"start":15.06,"end":15.26}]},{"id":"5","text":"Stebėdami pagalvokite,","words":[{"from":0,"to":9,"start":16.78,"end":17.34},{"from":10,"to":22,"start":17.34,"end":17.94}]},{"id":"6","text":"kuri veikla padėtų Andrea įveikti\ndabartinį sunkumą.","words":[{"from":0,"to":4,"start":18.58,"end":18.7},{"from":5,"to":11,"start":18.7,"end":19.14},{"from":12,"to":18,"start":19.14,"end":19.64},{"from":19,"to":25,"start":19.64,"end":20.12},{"from":26,"to":33,"start":20.12,"end":20.68},{"from":34,"to":43,"start":20.68,"end":21.26},{"from":44,"to":52,"start":21.26,"end":21.68}]}]}
