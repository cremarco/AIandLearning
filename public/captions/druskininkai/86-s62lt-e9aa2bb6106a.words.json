{"version":1,"cues":[{"id":"1","text":"Grįžkime prie pagrindinio Andrea klausimo:\nkodėl atsakymas gali pasikeisti","words":[{"from":0,"to":8,"start":0.18,"end":0.62},{"from":9,"to":13,"start":0.62,"end":0.86},{"from":14,"to":25,"start":0.86,"end":1.5},{"from":26,"to":32,"start":1.5,"end":1.9},{"from":33,"to":42,"start":1.9,"end":3.06},{"from":43,"to":48,"start":3.06,"end":3.32},{"from":49,"to":58,"start":3.32,"end":3.88},{"from":59,"to":63,"start":3.88,"end":4.18},{"from":64,"to":74,"start":4.24,"end":4.88}]},{"id":"2","text":"nepermokius modelio? Jis užduoda trumpą,\nkonkretų klausimą.","words":[{"from":0,"to":11,"start":4.88,"end":5.7},{"from":12,"to":20,"start":5.7,"end":6.94},{"from":21,"to":24,"start":6.94,"end":7.04},{"from":25,"to":32,"start":7.04,"end":7.48},{"from":33,"to":40,"start":7.48,"end":8.24},{"from":41,"to":49,"start":8.62,"end":8.76},{"from":50,"to":59,"start":8.76,"end":8.98}]},{"id":"3","text":"Tada palygina paaiškinimą ir jo nuorodas\nsu vadovėliu.","words":[{"from":0,"to":4,"start":9.94,"end":10.12},{"from":5,"to":13,"start":10.12,"end":10.66},{"from":14,"to":25,"start":10.66,"end":11.54},{"from":26,"to":28,"start":11.56,"end":11.72},{"from":29,"to":31,"start":11.72,"end":11.94},{"from":32,"to":40,"start":11.94,"end":12.46},{"from":41,"to":43,"start":12.52,"end":12.62},{"from":44,"to":54,"start":12.62,"end":13.14}]},{"id":"4","text":"Taip gauna atsakymą, kurį galima\nnuosekliai patikrinti.","words":[{"from":0,"to":4,"start":13.72,"end":13.92},{"from":5,"to":10,"start":13.92,"end":14.2},{"from":11,"to":20,"start":14.2,"end":15.06},{"from":21,"to":25,"start":15.06,"end":15.24},{"from":26,"to":32,"start":15.24,"end":15.68},{"from":33,"to":43,"start":15.68,"end":16.4},{"from":44,"to":55,"start":16.4,"end":16.5}]}]}
