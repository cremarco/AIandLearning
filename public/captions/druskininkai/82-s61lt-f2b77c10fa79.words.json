{"version":1,"cues":[{"id":"1","text":"Pradedame nuo vadovėlio pridėjimo.","words":[{"from":0,"to":9,"start":0,"end":0.62},{"from":10,"to":13,"start":0.62,"end":0.88},{"from":14,"to":23,"start":0.88,"end":1.42},{"from":24,"to":34,"start":1.42,"end":3.3}]},{"id":"2","text":"Andrea patikrina importuotą tekstą ir\npasirenka savo klausimo šaltinius.","words":[{"from":0,"to":6,"start":3.46,"end":3.46},{"from":7,"to":16,"start":3.46,"end":4.02},{"from":17,"to":27,"start":4.02,"end":4.7},{"from":28,"to":34,"start":4.72,"end":5.22},{"from":35,"to":37,"start":5.22,"end":5.48},{"from":38,"to":47,"start":5.48,"end":6.12},{"from":48,"to":52,"start":6.12,"end":6.4},{"from":53,"to":61,"start":6.42,"end":6.9},{"from":62,"to":72,"start":6.9,"end":8.2}]},{"id":"3","text":"Tai padeda apriboti užduotį, tačiau\natsakyme vis tiek gali būti klaidų.","words":[{"from":0,"to":3,"start":8.2,"end":8.32},{"from":4,"to":10,"start":8.32,"end":8.7},{"from":11,"to":19,"start":8.7,"end":9.24},{"from":20,"to":28,"start":9.24,"end":9.56},{"from":29,"to":35,"start":10.16,"end":10.44},{"from":36,"to":44,"start":10.44,"end":11.1},{"from":45,"to":48,"start":11.1,"end":11.34},{"from":49,"to":53,"start":11.48,"end":11.76},{"from":54,"to":58,"start":11.76,"end":11.96},{"from":59,"to":63,"start":11.96,"end":12.2},{"from":64,"to":71,"start":12.2,"end":12.56}]},{"id":"4","text":"Jį reikės patikrinti pagal vadovėlį.","words":[{"from":0,"to":2,"start":13.38,"end":13.48},{"from":3,"to":9,"start":13.48,"end":13.84},{"from":10,"to":20,"start":13.86,"end":14.44},{"from":21,"to":26,"start":14.44,"end":14.72},{"from":27,"to":36,"start":14.72,"end":15.18}]}]}
