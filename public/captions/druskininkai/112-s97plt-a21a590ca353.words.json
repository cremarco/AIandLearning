{"version":1,"cues":[{"id":"1","text":"Kai kurios priemonės suteikia daugiau\nfunkcijų pasirinkus mokamą planą.","words":[{"from":0,"to":3,"start":0.06,"end":0.18},{"from":4,"to":10,"start":0.18,"end":0.6},{"from":11,"to":20,"start":0.66,"end":1.26},{"from":21,"to":29,"start":1.26,"end":1.62},{"from":30,"to":37,"start":1.62,"end":2.1},{"from":38,"to":46,"start":2.18,"end":2.72},{"from":47,"to":57,"start":2.74,"end":3.38},{"from":58,"to":64,"start":3.4,"end":3.98},{"from":65,"to":71,"start":3.98,"end":4.88}]},{"id":"2","text":"Prieš mokėdami palyginkite reikiamą\nfunkciją su nemokama alternatyva ir","words":[{"from":0,"to":5,"start":4.9,"end":5.12},{"from":6,"to":14,"start":5.28,"end":5.72},{"from":15,"to":26,"start":5.86,"end":6.5},{"from":27,"to":35,"start":6.5,"end":7.04},{"from":36,"to":44,"start":7.12,"end":7.56},{"from":45,"to":47,"start":7.7,"end":7.8},{"from":48,"to":56,"start":7.8,"end":8.4},{"from":57,"to":68,"start":8.4,"end":9.2},{"from":69,"to":71,"start":9.2,"end":9.48}]},{"id":"3","text":"patikrinkite galiojančias sąlygas.","words":[{"from":0,"to":12,"start":9.52,"end":10.24},{"from":13,"to":25,"start":10.3,"end":10.86},{"from":26,"to":34,"start":10.86,"end":11.06}]},{"id":"4","text":"Mokama priemonė naudinga tik tada, kai\npapildoma funkcija padeda atlikti jūsų","words":[{"from":0,"to":6,"start":12.24,"end":12.64},{"from":7,"to":15,"start":12.64,"end":13.16},{"from":16,"to":24,"start":13.16,"end":13.7},{"from":25,"to":28,"start":13.84,"end":13.94},{"from":29,"to":34,"start":13.94,"end":14.28},{"from":35,"to":38,"start":14.48,"end":14.66},{"from":39,"to":48,"start":14.68,"end":15.28},{"from":49,"to":57,"start":15.38,"end":15.82},{"from":58,"to":64,"start":15.9,"end":16.24},{"from":65,"to":72,"start":16.24,"end":16.78},{"from":73,"to":77,"start":17.06,"end":17.16}]},{"id":"5","text":"užduotį.","words":[{"from":0,"to":8,"start":17.16,"end":17.34}]}]}
