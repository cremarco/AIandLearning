{"version":1,"cues":[{"id":"1","text":"Andrea mokymąsi galime suskirstyti į šešis\netapus.","words":[{"from":0,"to":6,"start":0.44,"end":0.44},{"from":7,"to":15,"start":0.44,"end":1.1},{"from":16,"to":22,"start":1.1,"end":1.42},{"from":23,"to":34,"start":1.42,"end":2.22},{"from":35,"to":36,"start":2.22,"end":2.44},{"from":37,"to":42,"start":2.44,"end":2.9},{"from":43,"to":50,"start":2.9,"end":3.08}]},{"id":"2","text":"Kiekvienas etapas padeda pasirinkti, ką\ndaryti toliau.","words":[{"from":0,"to":10,"start":4.3,"end":4.66},{"from":11,"to":17,"start":4.66,"end":5.24},{"from":18,"to":24,"start":5.3,"end":5.66},{"from":25,"to":36,"start":5.66,"end":6.32},{"from":37,"to":39,"start":6.32,"end":6.7},{"from":40,"to":46,"start":6.7,"end":7.08},{"from":47,"to":54,"start":7.08,"end":8.24}]},{"id":"3","text":"Pirmiausia jis planuoja tikslą ir mokymosi\nlaiką.","words":[{"from":0,"to":10,"start":8.24,"end":8.72},{"from":11,"to":14,"start":8.8,"end":9.02},{"from":15,"to":23,"start":9.06,"end":9.5},{"from":24,"to":30,"start":9.5,"end":10.1},{"from":31,"to":33,"start":10.1,"end":10.36},{"from":34,"to":42,"start":10.36,"end":11.06},{"from":43,"to":49,"start":11.06,"end":11.94}]},{"id":"4","text":"Norėdamas suprasti idėją, jis nagrinėja\npaaiškinimą ar pavyzdį.","words":[{"from":0,"to":9,"start":11.98,"end":12.38},{"from":10,"to":18,"start":12.42,"end":12.84},{"from":19,"to":25,"start":12.84,"end":13.64},{"from":26,"to":29,"start":13.68,"end":13.84},{"from":30,"to":39,"start":13.84,"end":14.34},{"from":40,"to":51,"start":14.34,"end":15.18},{"from":52,"to":54,"start":15.36,"end":15.46},{"from":55,"to":63,"start":15.46,"end":16.5}]},{"id":"5","text":"Tada, naudodamas žemėlapį, jis susieja ją\nsu tuo, ką jau žino.","words":[{"from":0,"to":5,"start":16.8,"end":17.08},{"from":6,"to":16,"start":17.08,"end":17.58},{"from":17,"to":26,"start":17.58,"end":18.5},{"from":27,"to":30,"start":18.5,"end":18.6},{"from":31,"to":38,"start":18.64,"end":19.12},{"from":39,"to":41,"start":19.12,"end":19.36},{"from":42,"to":44,"start":19.36,"end":19.58},{"from":45,"to":49,"start":19.58,"end":20.1},{"from":50,"to":52,"start":20.1,"end":20.18},{"from":53,"to":56,"start":20.18,"end":20.34},{"from":57,"to":62,"start":20.34,"end":21.22}]},{"id":"6","text":"Toliau jis bando prisiminti be vadovėlio\nir po kurio laiko vėl pakartoja.","words":[{"from":0,"to":6,"start":21.22,"end":21.46},{"from":7,"to":10,"start":21.46,"end":21.78},{"from":11,"to":16,"start":21.78,"end":22.02},{"from":17,"to":27,"start":22.02,"end":22.64},{"from":28,"to":30,"start":22.64,"end":22.9},{"from":31,"to":40,"start":22.9,"end":23.42},{"from":41,"to":43,"start":23.64,"end":23.74},{"from":44,"to":46,"start":23.74,"end":23.96},{"from":47,"to":52,"start":24.02,"end":24.2},{"from":53,"to":58,"start":24.24,"end":24.54},{"from":59,"to":62,"start":24.54,"end":24.92},{"from":63,"to":73,"start":24.92,"end":25.02}]},{"id":"7","text":"Norėdamas taikyti žinias, jis nagrinėja\nnaują pavyzdį.","words":[{"from":0,"to":9,"start":26.12,"end":26.54},{"from":10,"to":17,"start":26.6,"end":27.06},{"from":18,"to":25,"start":27.06,"end":27.64},{"from":26,"to":29,"start":27.72,"end":27.82},{"from":30,"to":39,"start":27.82,"end":28.38},{"from":40,"to":45,"start":28.38,"end":28.76},{"from":46,"to":54,"start":28.76,"end":28.86}]},{"id":"8","text":"Galiausiai jis tikrina savo atsakymą pagal\nšaltinį ir kriterijus.","words":[{"from":0,"to":10,"start":29.94,"end":30.54},{"from":11,"to":14,"start":30.54,"end":30.7},{"from":15,"to":22,"start":30.84,"end":31.12},{"from":23,"to":27,"start":31.12,"end":31.44},{"from":28,"to":36,"start":31.44,"end":32},{"from":37,"to":42,"start":32.1,"end":32.28},{"from":43,"to":50,"start":32.28,"end":32.9},{"from":51,"to":53,"start":32.92,"end":33.1},{"from":54,"to":65,"start":33.1,"end":34.3}]},{"id":"9","text":"Prireikus jis gali grįžti į ankstesnį\netapą.","words":[{"from":0,"to":9,"start":34.3,"end":34.82},{"from":10,"to":13,"start":34.86,"end":35.06},{"from":14,"to":18,"start":35.06,"end":35.34},{"from":19,"to":25,"start":35.34,"end":35.78},{"from":26,"to":27,"start":35.78,"end":35.9},{"from":28,"to":37,"start":35.9,"end":36.5},{"from":38,"to":44,"start":36.5,"end":37.4}]},{"id":"10","text":"Juosta rodo","words":[{"from":0,"to":6,"start":37.46,"end":37.78},{"from":7,"to":11,"start":37.78,"end":38.1}]},{"id":"11","text":"pagrindinį ir papildomą etapą. Pagalba\napima pasirengimą, šaltinius ir","words":[{"from":0,"to":10,"start":38.78,"end":38.88},{"from":11,"to":13,"start":38.88,"end":39},{"from":14,"to":23,"start":39,"end":39.68},{"from":24,"to":30,"start":39.68,"end":40.5},{"from":31,"to":38,"start":40.5,"end":41.04},{"from":39,"to":44,"start":41.04,"end":41.44},{"from":45,"to":57,"start":41.44,"end":42.2},{"from":58,"to":67,"start":42.48,"end":43.08},{"from":68,"to":70,"start":43.22,"end":43.36}]},{"id":"12","text":"dalijimąsi.","words":[{"from":0,"to":11,"start":43.36,"end":43.8}]}]}
