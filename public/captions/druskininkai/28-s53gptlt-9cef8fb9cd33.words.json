{"version":1,"cues":[{"id":"1","text":"Naudodami ChatGPT, pradedame nuo Andrea\nporeikio.","words":[{"from":0,"to":9,"start":0.66,"end":0.76},{"from":10,"to":18,"start":0.76,"end":1.7},{"from":19,"to":28,"start":1.98,"end":2.52},{"from":29,"to":32,"start":2.52,"end":2.76},{"from":33,"to":39,"start":2.82,"end":3.22},{"from":40,"to":49,"start":3.22,"end":3.44}]},{"id":"2","text":"Ar jam reikia suprasti idėją, sudaryti\nžemėlapį, ar pasipraktikuoti atsakyti?","words":[{"from":0,"to":2,"start":5.06,"end":5.1},{"from":3,"to":6,"start":5.1,"end":5.3},{"from":7,"to":13,"start":5.3,"end":5.62},{"from":14,"to":22,"start":5.62,"end":6.12},{"from":23,"to":29,"start":6.12,"end":6.84},{"from":30,"to":38,"start":7.08,"end":7.52},{"from":39,"to":48,"start":7.52,"end":8.36},{"from":49,"to":51,"start":8.72,"end":8.8},{"from":52,"to":67,"start":8.84,"end":9.64},{"from":68,"to":77,"start":9.64,"end":9.74}]},{"id":"3","text":"Priemonė gali parengti medžiagą, tačiau\nAndrea vis tiek turi pats paaiškinti arba","words":[{"from":0,"to":8,"start":10.98,"end":11.4},{"from":9,"to":13,"start":11.4,"end":11.7},{"from":14,"to":22,"start":11.7,"end":12.16},{"from":23,"to":32,"start":12.16,"end":12.44},{"from":33,"to":39,"start":12.98,"end":13.22},{"from":40,"to":46,"start":13.22,"end":13.78},{"from":47,"to":50,"start":13.78,"end":14.06},{"from":51,"to":55,"start":14.16,"end":14.36},{"from":56,"to":60,"start":14.4,"end":14.64},{"from":61,"to":65,"start":14.9,"end":15.04},{"from":66,"to":76,"start":15.04,"end":15.6},{"from":77,"to":81,"start":15.66,"end":15.98}]},{"id":"4","text":"patobulinti atsakymą.","words":[{"from":0,"to":11,"start":16.04,"end":16.74},{"from":12,"to":21,"start":16.74,"end":16.84}]},{"id":"5","text":"Pažiūrėkime, kaip to paprašyti.","words":[{"from":0,"to":12,"start":17.82,"end":18.48},{"from":13,"to":17,"start":18.64,"end":18.84},{"from":18,"to":20,"start":18.86,"end":18.96},{"from":21,"to":31,"start":18.96,"end":19.48}]}]}
