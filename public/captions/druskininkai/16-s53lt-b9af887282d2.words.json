{"version":1,"cues":[{"id":"1","text":"Šiam bandymui Andrea reikia puikios\nknygos.","words":[{"from":0,"to":4,"start":0.12,"end":0.38},{"from":5,"to":13,"start":0.38,"end":0.96},{"from":14,"to":20,"start":1.04,"end":1.52},{"from":21,"to":27,"start":1.52,"end":1.9},{"from":28,"to":35,"start":2.02,"end":2.5},{"from":36,"to":43,"start":2.5,"end":3.96}]},{"id":"2","text":"Žinoma, juokauju. Tai seminarui sukurta\nišgalvota knyga, kurioje pateikti tikri","words":[{"from":0,"to":7,"start":3.96,"end":4.68},{"from":8,"to":17,"start":4.72,"end":5.98},{"from":18,"to":21,"start":6.06,"end":6.06},{"from":22,"to":31,"start":6.06,"end":6.6},{"from":32,"to":39,"start":6.6,"end":7.08},{"from":40,"to":49,"start":7.08,"end":7.8},{"from":50,"to":56,"start":7.8,"end":8.34},{"from":57,"to":64,"start":8.54,"end":8.8},{"from":65,"to":73,"start":8.8,"end":9.3},{"from":74,"to":79,"start":9.3,"end":9.72}]},{"id":"3","text":"paaiškinimai ir techniniai šaltiniai.","words":[{"from":0,"to":12,"start":9.72,"end":10.5},{"from":13,"to":15,"start":10.56,"end":10.8},{"from":16,"to":26,"start":11.02,"end":11.34},{"from":27,"to":37,"start":11.34,"end":12.44}]},{"id":"4","text":"Demonstracijoms naudosiu šią knygą.","words":[{"from":0,"to":15,"start":12.44,"end":13.16},{"from":16,"to":24,"start":13.16,"end":13.74},{"from":25,"to":28,"start":13.74,"end":14},{"from":29,"to":35,"start":14,"end":14.1}]},{"id":"5","text":"Tą patį metodą galima pritaikyti kitų\ndalykų šaltiniams.","words":[{"from":0,"to":2,"start":14.92,"end":15},{"from":3,"to":7,"start":15.04,"end":15.26},{"from":8,"to":14,"start":15.26,"end":15.74},{"from":15,"to":21,"start":15.74,"end":16.06},{"from":22,"to":32,"start":16.06,"end":16.74},{"from":33,"to":37,"start":16.78,"end":17.12},{"from":38,"to":44,"start":17.12,"end":17.5},{"from":45,"to":56,"start":17.5,"end":17.92}]}]}
