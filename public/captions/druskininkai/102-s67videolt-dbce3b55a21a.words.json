{"version":1,"cues":[{"id":"1","text":"Video Overview sukuria pasirinktais\nšaltiniais pagrįstą įgarsintą vaizdo įrašą","words":[{"from":0,"to":5,"start":0.5,"end":0.5},{"from":6,"to":14,"start":0.5,"end":1.14},{"from":15,"to":22,"start":1.14,"end":1.62},{"from":23,"to":35,"start":1.66,"end":2.28},{"from":36,"to":46,"start":2.28,"end":2.86},{"from":47,"to":55,"start":2.9,"end":3.5},{"from":56,"to":65,"start":3.52,"end":4.26},{"from":66,"to":72,"start":4.26,"end":4.58},{"from":73,"to":78,"start":4.58,"end":5.2}]},{"id":"2","text":"su vaizdine medžiaga.","words":[{"from":0,"to":2,"start":5.26,"end":5.38},{"from":3,"to":11,"start":5.38,"end":5.82},{"from":12,"to":21,"start":5.82,"end":5.98}]},{"id":"3","text":"Balsas ir vaizdai kartu gali padėti Andrea\nsekti procesą arba suprasti abstrakčią","words":[{"from":0,"to":6,"start":7.2,"end":7.52},{"from":7,"to":9,"start":7.52,"end":7.7},{"from":10,"to":17,"start":7.7,"end":8.24},{"from":18,"to":23,"start":8.34,"end":8.7},{"from":24,"to":28,"start":8.7,"end":8.94},{"from":29,"to":35,"start":8.94,"end":9.36},{"from":36,"to":42,"start":9.36,"end":9.72},{"from":43,"to":48,"start":9.72,"end":10.22},{"from":49,"to":56,"start":10.42,"end":10.92},{"from":57,"to":61,"start":10.94,"end":11.24},{"from":62,"to":70,"start":11.4,"end":11.7},{"from":71,"to":81,"start":11.9,"end":12.32}]},{"id":"4","text":"idėją.","words":[{"from":0,"to":6,"start":12.32,"end":12.6}]},{"id":"5","text":"Pažiūrėkime ir sustokime:","words":[{"from":0,"to":11,"start":13.42,"end":14.16},{"from":12,"to":14,"start":14.2,"end":14.38},{"from":15,"to":25,"start":14.38,"end":14.8}]},{"id":"6","text":"kaip paaiškintumėte šią idėją savais\nžodžiais?","words":[{"from":0,"to":4,"start":15.66,"end":15.82},{"from":5,"to":19,"start":15.82,"end":16.62},{"from":20,"to":23,"start":16.62,"end":16.84},{"from":24,"to":29,"start":16.84,"end":17.26},{"from":30,"to":36,"start":17.26,"end":17.62},{"from":37,"to":46,"start":17.62,"end":17.72}]},{"id":"7","text":"Andrea patikrina savo p