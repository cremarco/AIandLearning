{"version":1,"cues":[{"id":"1","text":"Išmokęs terminus, Andrea turi susieti\nidėjas.","words":[{"from":0,"to":7,"start":0.24,"end":0.68},{"from":8,"to":17,"start":0.68,"end":1.24},{"from":18,"to":24,"start":1.42,"end":1.88},{"from":25,"to":29,"start":1.88,"end":2.24},{"from":30,"to":37,"start":2.24,"end":2.78},{"from":38,"to":45,"start":2.78,"end":4.08}]},{"id":"2","text":"Jis gali sudaryti sąvokų žemėlapį, susieti\napibrėžtis ar klasifikuoti pavyzdžius.","words":[{"from":0,"to":3,"start":4.08,"end":4.16},{"from":4,"to":8,"start":4.16,"end":4.46},{"from":9,"to":17,"start":4.46,"end":4.98},{"from":18,"to":24,"start":4.98,"end":5.54},{"from":25,"to":34,"start":5.54,"end":6.26},{"from":35,"to":42,"start":6.54,"end":6.9},{"from":43,"to":53,"start":7.06,"end":7.66},{"from":54,"to":56,"start":7.66,"end":8.02},{"from":57,"to":69,"start":8.04,"end":8.76},{"from":70,"to":81,"start":8.76,"end":8.98}]},{"id":"3","text":"Žodinė praktika skatina paaiškinti tuos\nryšius savais žodžiais.","words":[{"from":0,"to":6,"start":10.18,"end":10.52},{"from":7,"to":15,"start":10.54,"end":11},{"from":16,"to":23,"start":11.14,"end":11.5},{"from":24,"to":34,"start":11.5,"end":12.18},{"from":35,"to":39,"start":12.2,"end":12.42},{"from":40,"to":46,"start":12.48,"end":12.96},{"from":47,"to":53,"start":13,"end":13.38},{"from":54,"to":63,"start":13.38,"end":13.64}]},{"id":"4","text":"Kiekvienoje veikloje jis tikrina savo\nsamprotavimą pagal vadovėlį.","words":[{"from":0,"to":11,"start":14.56,"end":15.1},{"from":12,"to":20,"start":15.1,"end":15.72},{"from":21,"to":24,"start":15.72,"end":16},{"from":25,"to":32,"start":16.06,"end":16.42},{"from":33,"to":37,"start":16.42,"end":16.8},{"from":38,"to":50,"start":16.82,"end":17.68},{"from":51,"to":56,"start":17.7,"end":18.06},{"from":57,"to":66,"start":18.06,"end":18.54}]}]}
