{"version":1,"cues":[{"id":"1","text":"Šis susitikimas skirtas įvairių dalykų\nmokytojams, norintiems, kad mokiniai","words":[{"from":0,"to":3,"start":0.24,"end":0.26},{"from":4,"to":15,"start":0.26,"end":0.92},{"from":16,"to":23,"start":0.92,"end":1.46},{"from":24,"to":31,"start":1.54,"end":2.04},{"from":32,"to":38,"start":2.04,"end":2.46},{"from":39,"to":50,"start":2.46,"end":3.2},{"from":51,"to":62,"start":3.3,"end":3.94},{"from":63,"to":66,"start":4.18,"end":4.18},{"from":67,"to":75,"start":4.18,"end":4.66}]},{"id":"2","text":"naudotų DI ir prisiimtų atsakomybę už savo\nmokymąsi.","words":[{"from":0,"to":7,"start":4.66,"end":5.1},{"from":8,"to":10,"start":5.16,"end":5.62},{"from":11,"to":13,"start":5.62,"end":6},{"from":14,"to":23,"start":6.04,"end":6.5},{"from":24,"to":34,"start":6.5,"end":7.2},{"from":35,"to":37,"start":7.32,"end":7.42},{"from":38,"to":42,"start":7.42,"end":7.68},{"from":43,"to":52,"start":7.68,"end":7.86}]},{"id":"3","text":"Stebėsime studento mokymosi procesą:\ntikslo nustatymą, darbą su šaltiniu,","words":[{"from":0,"to":9,"start":9.38,"end":9.72},{"from":10,"to":18,"start":9.72,"end":10.3},{"from":19,"to":27,"start":10.3,"end":10.94},{"from":28,"to":36,"start":10.94,"end":11.82},{"from":37,"to":43,"start":12,"end":12.14},{"from":44,"to":54,"start":12.14,"end":13.1},{"from":55,"to":60,"start":13.36,"end":13.42},{"from":61,"to":63,"start":13.42,"end":13.6},{"from":64,"to":73,"start":13.6,"end":14.16}]},{"id":"4","text":"vaizdinį idėjų perteikimą ir supratimo\ntikrinimą.","words":[{"from":0,"to":8,"start":14.7,"end":15.08},{"from":9,"to":14,"start":15.08,"end":15.48},{"from":15,"to":25,"start":15.54,"end":16.2},{"from":26,"to":28,"start":16.2,"end":16.5},{"from":29,"to":38,"start":16.5,"end":17.08},{"from":39,"to":49,"start":17.08,"end":17.18}]},{"id":"5","text":"Sąvokų žemėlapiai ir įsivertinimas suteiks\nkonkrečių pavyzdžių.","words":[{"from":0,"to":6,"start":18.34,"end":18.58},{"from":7,"to":17,"start":18.58,"end":19.32},{"from":18,"to":20