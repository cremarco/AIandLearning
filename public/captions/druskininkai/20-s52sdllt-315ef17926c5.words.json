{"version":1,"cues":[{"id":"1","text":"Šios veiklos skatina Andrea pačiam priimti\nmokymosi sprendimus.","words":[{"from":0,"to":4,"start":0.16,"end":0.34},{"from":5,"to":12,"start":0.34,"end":0.74},{"from":13,"to":20,"start":0.74,"end":1.26},{"from":21,"to":27,"start":1.26,"end":1.76},{"from":28,"to":34,"start":1.76,"end":2.34},{"from":35,"to":42,"start":2.34,"end":2.8},{"from":43,"to":51,"start":2.8,"end":3.4},{"from":52,"to":63,"start":3.4,"end":4.76}]},{"id":"2","text":"Tai savivaldus mokymasis:","words":[{"from":0,"to":3,"start":4.84,"end":4.84},{"from":4,"to":14,"start":4.84,"end":5.52},{"from":15,"to":25,"start":5.52,"end":5.7}]},{"id":"3","text":"jis nusistato tikslą, pasirenka mokymosi\nbūdą ir peržiūri pažangą.","words":[{"from":0,"to":3,"start":6.72,"end":6.82},{"from":4,"to":13,"start":6.82,"end":7.44},{"from":14,"to":21,"start":7.44,"end":7.9},{"from":22,"to":31,"start":8.2,"end":8.72},{"from":32,"to":40,"start":8.76,"end":9.32},{"from":41,"to":45,"start":9.32,"end":9.72},{"from":46,"to":48,"start":9.8,"end":9.96},{"from":49,"to":57,"start":10,"end":10.48},{"from":58,"to":66,"start":10.48,"end":11.7}]},{"id":"4","text":"Mokytojai ir bendramoksliai gali padėti,","words":[{"from":0,"to":9,"start":11.7,"end":12.24},{"from":10,"to":12,"start":12.24,"end":12.4},{"from":13,"to":27,"start":12.4,"end":13.2},{"from":28,"to":32,"start":13.2,"end":13.52},{"from":33,"to":40,"start":13.52,"end":13.68}]},{"id":"5","text":"tačiau atsakomybė už pasirinkimus lieka\njam.","words":[{"from":0,"to":6,"start":14.34,"end":14.56},{"from":7,"to":17,"start":14.56,"end":15.24},{"from":18,"to":20,"start":15.24,"end":15.38},{"from":21,"to":33,"start":15.44,"end":16.24},{"from":34,"to":39,"start":16.52,"end":16.62},{"from":40,"to":44,"start":16.62,"end":16.92}]}]}
