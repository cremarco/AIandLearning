{"version":1,"cues":[{"id":"1","text":"Jei vadovėlio nepakanka, Andrea gali\nieškoti daugiau šaltinių.","words":[{"from":0,"to":3,"start":0.18,"end":0.4},{"from":4,"to":13,"start":0.4,"end":0.86},{"from":14,"to":24,"start":0.86,"end":2.1},{"from":25,"to":31,"start":2.3,"end":2.3},{"from":32,"to":36,"start":2.3,"end":2.62},{"from":37,"to":44,"start":2.62,"end":3.14},{"from":45,"to":52,"start":3.14,"end":3.56},{"from":53,"to":62,"start":3.56,"end":4.76}]},{"id":"2","text":"Prieš importuodamas rezultatą, jis\npatikrina, kas jį sukūrė,","words":[{"from":0,"to":5,"start":4.76,"end":4.98},{"from":6,"to":19,"start":4.98,"end":5.62},{"from":20,"to":30,"start":5.62,"end":6.66},{"from":31,"to":34,"start":6.7,"end":6.8},{"from":35,"to":45,"start":6.8,"end":7.26},{"from":46,"to":49,"start":7.78,"end":7.78},{"from":50,"to":52,"start":7.78,"end":7.96},{"from":53,"to":60,"start":7.96,"end":8.06}]},{"id":"3","text":"ar jis atsako į klausimą ir ar yra\npatikimas.","words":[{"from":0,"to":2,"start":8.98,"end":9.04},{"from":3,"to":6,"start":9.04,"end":9.18},{"from":7,"to":13,"start":9.18,"end":9.6},{"from":14,"to":15,"start":9.6,"end":9.72},{"from":16,"to":24,"start":9.76,"end":10.38},{"from":25,"to":27,"start":10.44,"end":10.7},{"from":28,"to":30,"start":10.76,"end":10.96},{"from":31,"to":34,"start":10.96,"end":11.16},{"from":35,"to":45,"start":11.16,"end":12.54}]},{"id":"4","text":"Rastas šaltinis nebūtinai turi būti\npanaudotas.","words":[{"from":0,"to":6,"start":12.54,"end":12.84},{"from":7,"to":15,"start":12.84,"end":13.44},{"from":16,"to":25,"start":13.44,"end":14.16},{"from":26,"to":30,"start":14.2,"end":14.42},{"from":31,"to":35,"start":14.42,"end":14.66},{"from":36,"to":47,"start":14.66,"end":15.12}]}]}
