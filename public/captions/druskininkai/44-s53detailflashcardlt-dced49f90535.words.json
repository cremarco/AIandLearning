{"version":1,"cues":[{"id":"1","text":"Pradedame nuo pagal vadovėlį sukurtų\nkortelių.","words":[{"from":0,"to":9,"start":0.12,"end":0.66},{"from":10,"to":13,"start":0.66,"end":0.92},{"from":14,"to":19,"start":0.92,"end":1.3},{"from":20,"to":28,"start":1.3,"end":1.92},{"from":29,"to":36,"start":1.92,"end":2.4},{"from":37,"to":46,"start":2.4,"end":3.98}]},{"id":"2","text":"Andrea atsako iš atminties, atveria\npaaiškinimą ir įsivertina prisiminimą.","words":[{"from":0,"to":6,"start":4.22,"end":4.22},{"from":7,"to":13,"start":4.22,"end":4.72},{"from":14,"to":16,"start":4.72,"end":4.9},{"from":17,"to":27,"start":4.9,"end":5.92},{"from":28,"to":35,"start":5.92,"end":6.32},{"from":36,"to":47,"start":6.36,"end":7.16},{"from":48,"to":50,"start":7.16,"end":7.38},{"from":51,"to":61,"start":7.58,"end":8.12},{"from":62,"to":74,"start":8.12,"end":8.74}]},{"id":"3","text":"Įvertinęs jis pereina prie kitos kortelės.","words":[{"from":0,"to":9,"start":9.48,"end":10.24},{"from":10,"to":13,"start":10.24,"end":10.38},{"from":14,"to":21,"start":10.42,"end":10.82},{"from":22,"to":26,"start":10.82,"end":11.06},{"from":27,"to":32,"start":11.06,"end":11.44},{"from":33,"to":42,"start":11.44,"end":12.84}]},{"id":"4","text":"Dešimt klausimų ir atsakymų jis gali\natsisiųsti kaip CSV failą, kad vėliau","words":[{"from":0,"to":6,"start":12.84,"end":13.22},{"from":7,"to":15,"start":13.24,"end":13.76},{"from":16,"to":18,"start":13.76,"end":13.82},{"from":19,"to":27,"start":13.82,"end":14.48},{"from":28,"to":31,"start":14.48,"end":14.66},{"from":32,"to":36,"start":14.66,"end":14.94},{"from":37,"to":47,"start":14.94,"end":15.48},{"from":48,"to":52,"start":15.48,"end":15.8},{"from":53,"to":56,"start":15.88,"end":16.38},{"from":57,"to":63,"start":16.38,"end":16.94},{"from":64,"to":67,"start":17.22,"end":17.32},{"from":68,"to":74,"start":17.32,"end":17.64}]},{"id":"5","text":"galėtų kartoti.","words":[{"from":0,"to":6,"start":17.64,"end":18.04},{"from":7,"to":15,"start":18.04,"end":18.2}]}]}
