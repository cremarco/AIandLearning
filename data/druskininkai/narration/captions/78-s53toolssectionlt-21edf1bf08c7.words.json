  "cues": [
    {
      "start": 0.0,
      "end": 5.32,
      "text": "Išnagrinėjome užklausų trumpinius, skirtus\nįvairioms mokymosi veikloms."
    },
    {
      "start": 5.32,
      "end": 8.94,
      "text": "Dabar pažvelkime į mokymąsi pagal\nšaltinius su Gemini Notebook."
    },
    {
      "start": 10.0,
      "end": 11.42,
      "text": "Ir toliau kelsime du klausimus:"
    },
    {
      "start": 12.36,
      "end": 17.26,
      "text": "kokią problemą padeda spręsti ši priemonė\nir kaip Andrea parodys, ką išmoko?"
    }
  ]
