  "cues": [
    {
      "start": 0.16,
      "end": 4.34,
      "text": "Esu Marco Cremaschi, University of\nMilano-Bicocca docentas."
    },
    {
      "start": 4.34,
      "end": 7.14,
      "text": "Savo darbe sieju DI su praktinėmis\nproblemomis."
    },
    {
      "start": 8.38,
      "end": 12.82,
      "text": "Taip pat dėstau vaizdinę komunikaciją,\nsąsajų projektavimą ir programavimą,"
    },
    {
      "start": 13.44,
      "end": 17.32,
      "text": "įskaitant technologijų naudojimą\npsichologijos ir psichiatrijos srityse."
    }
  ]
