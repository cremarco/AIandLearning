  "cues": [
    {
      "start": 0.24,
      "end": 4.66,
      "text": "Šis susitikimas skirtas įvairių dalykų\nmokytojams, norintiems, kad mokiniai"
    },
    {
      "start": 4.66,
      "end": 7.98,
      "text": "naudotų DI ir prisiimtų atsakomybę už savo\nmokymąsi."
    },
    {
      "start": 9.38,
      "end": 14.28,
      "text": "Stebėsime studento mokymosi procesą:\ntikslo nustatymą, darbą su šaltiniu,"
    },
    {
      "start": 14.7,
      "end": 17.3,
      "text": "vaizdinį idėjų perteikimą ir supratimo\ntikrinimą."
    },
    {
      "start": 18.34,
      "end": 21.84,
      "text": "Sąvokų žemėlapiai ir įsivertinimas suteiks\nkonkrečių pavyzdžių."
    },
    {
      "start": 22.8,
      "end": 26.98,
      "text": "Nagrinėdami priemones, pagalvokite apie\nsavo mokomąjį dalyką ir mokinius."
    },
    {
      "start": 27.82,
      "end": 32.86,
      "text": "Aptarsime neapibrėžtumą, nusivylimą ir\nkritinį mąstymą bei klausime, ką"
    },
    {
      "start": 32.86,
      "end": 36.08,
      "text": "besimokantysis gali paaiškinti\nsavarankiškai."
    },
    {
      "start": 36.08,
      "end": 41.48,
      "text": "Tikslas – išsinešti praktinių atsakingo DI\nnaudojimo idėjų, kurias galėtumėte"
    },
    {
      "start": 41.54,
      "end": 43.12,
      "text": "pritaikyti savo pamokose."
    }
  ]
}
