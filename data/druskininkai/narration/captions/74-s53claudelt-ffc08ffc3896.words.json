  "cues": [
    {
      "start": 0.24,
      "end": 4.44,
      "text": "Ar šias užklausas galime naudoti su kitu\nasistentu?"
    },
    {
      "start": 4.44,
      "end": 9.38,
      "text": "Naudojant Claude, tas pats vadovėlis ir\nužklausos leido gauti penkis veikiančius"
    },
    {
      "start": 9.38,
      "end": 10.08,
      "text": "pavyzdžius:"
    },
    {
      "start": 10.64,
      "end": 15.78,
      "text": "korteles, testą, žodinę praktiką, klaidų\nžurnalą ir sąvokų žemėlapį."
    },
    {
      "start": 16.76,
      "end": 19.92,
      "text": "Sąsaja keičiasi, bet užduotis lieka ta\npati."
    }
  ]
