  "cues": [
    {
      "start": 0.16,
      "end": 4.84,
      "text": "Šios veiklos skatina Andrea pačiam priimti\nmokymosi sprendimus."
    },
    {
      "start": 4.84,
      "end": 5.82,
      "text": "Tai savivaldus mokymasis:"
    },
    {
      "start": 6.72,
      "end": 11.7,
      "text": "jis nusistato tikslą, pasirenka mokymosi\nbūdą ir peržiūri pažangą."
    },
    {
      "start": 11.7,
      "end": 13.8,
      "text": "Mokytojai ir bendramoksliai gali padėti,"
    },
    {
      "start": 14.34,
      "end": 17.04,
      "text": "tačiau atsakomybė už pasirinkimus lieka\njam."
    }
  ]
