  "cues": [
    {
      "start": 0.18,
      "end": 4.76,
      "text": "Jei vadovėlio nepakanka, Andrea gali\nieškoti daugiau šaltinių."
    },
    {
      "start": 4.76,
      "end": 8.18,
      "text": "Prieš importuodamas rezultatą, jis\npatikrina, kas jį sukūrė,"
    },
    {
      "start": 8.98,
      "end": 12.54,
      "text": "ar jis atsako į klausimą ir ar yra\npatikimas."
    },
    {
      "start": 12.54,
      "end": 15.24,
      "text": "Rastas šaltinis nebūtinai turi būti\npanaudotas."
    }
  ]
