  "cues": [
    {
      "start": 0.08,
      "end": 3.78,
      "text": "Šis žemėlapis sukurtas naudojant Mind Map."
    },
    {
      "start": 3.78,
      "end": 6.28,
      "text": "Jis susieja pagrindines sąvokas."
    },
    {
      "start": 6.28,
      "end": 9.34,
      "text": "Galime padidinti vaizdą ir perskaityti\nkiekvieną šaką."
    },
    {
      "start": 10.24,
      "end": 15.2,
      "text": "Kur keičiasi parametrai, o kur informacija\npridedama kaip įvestis?"
    },
    {
      "start": 15.2,
      "end": 19.3,
      "text": "Andrea patikrina ryšius pagal vadovėlį ir\ntada juos paaiškina be žemėlapio."
    }
  ]
