  "cues": [
    {
      "start": 0.5,
      "end": 5.26,
      "text": "Video Overview sukuria pasirinktais\nšaltiniais pagrįstą įgarsintą vaizdo įrašą"
    },
    {
      "start": 5.26,
      "end": 6.1,
      "text": "su vaizdine medžiaga."
    },
    {
      "start": 7.2,
      "end": 12.32,
      "text": "Balsas ir vaizdai kartu gali padėti Andrea\nsekti procesą arba suprasti abstrakčią"
    },
    {
      "start": 12.32,
      "end": 13.02,
      "text": "idėją."
    },
    {
      "start": 13.42,
      "end": 14.92,
      "text": "Pažiūrėkime ir sustokime:"
    },
    {
      "start": 15.66,
      "end": 17.84,
      "text": "kaip paaiškintumėte šią idėją savais\nžodžiais?"
    },
    {
      "start": 18.76,
      "end": 21.68,
      "text": "Andrea patikrina savo paaiškinimą pagal\nvadovėlį."
    }
  ]
