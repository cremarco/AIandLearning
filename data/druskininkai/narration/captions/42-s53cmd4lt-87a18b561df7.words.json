  "cues": [
    {
      "start": 0.14,
      "end": 2.14,
      "text": "Šioms veikloms taip pat reikia plano."
    },
    {
      "start": 3.36,
      "end": 8.1,
      "text": "Andrea gali naudoti /studyplan tolesniems\nžingsniams pasirinkti."
    },
    {
      "start": 8.72,
      "end": 14.12,
      "text": "Mokytojai gali planuoti pamoką, pritaikyti\npagalbos lygį arba sukurti mokymosi"
    },
    {
      "start": 14.12,
      "end": 20.04,
      "text": "stoteles. Bendri kriterijai gali padėti\nteikti grįžtamąjį ryšį vieni kitiems."
    },
    {
      "start": 20.04,
      "end": 23.44,
      "text": "Dabar peržiūrėsime po vieną kiekvienos\ngrupės pavyzdį."
    }
  ]
