  "cues": [
    {
      "start": 0.44,
      "end": 3.2,
      "text": "Andrea mokymąsi galime suskirstyti į šešis\netapus."
    },
    {
      "start": 4.3,
      "end": 8.24,
      "text": "Kiekvienas etapas padeda pasirinkti, ką\ndaryti toliau."
    },
    {
      "start": 8.24,
      "end": 11.98,
      "text": "Pirmiausia jis planuoja tikslą ir mokymosi\nlaiką."
    },
    {
      "start": 11.98,
      "end": 16.62,
      "text": "Norėdamas suprasti idėją, jis nagrinėja\npaaiškinimą ar pavyzdį."
    },
    {
      "start": 16.8,
      "end": 21.22,
      "text": "Tada, naudodamas žemėlapį, jis susieja ją\nsu tuo, ką jau žino."
    },
    {
      "start": 21.22,
      "end": 25.14,
      "text": "Toliau jis bando prisiminti be vadovėlio\nir po kurio laiko vėl pakartoja."
    },
    {
      "start": 26.12,
      "end": 28.98,
      "text": "Norėdamas taikyti žinias, jis nagrinėja\nnaują pavyzdį."
    },
    {
      "start": 29.94,
      "end": 34.3,
      "text": "Galiausiai jis tikrina savo atsakymą pagal\nšaltinį ir kriterijus."
    },
    {
      "start": 34.3,
      "end": 37.46,
      "text": "Prireikus jis gali grįžti į ankstesnį\netapą."
    },
    {
      "start": 37.46,
      "end": 38.22,
      "text": "Juosta rodo"
    },
    {
      "start": 38.78,
      "end": 43.36,
      "text": "pagrindinį ir papildomą etapą. Pagalba\napima pasirengimą, šaltinius ir"
    },
    {
      "start": 43.36,
      "end": 44.06,
      "text": "dalijimąsi."
    }
  ]
}
