  "cues": [
    {
      "start": 0.08,
      "end": 4.42,
      "text": "Testas suteikia dar vieną greitą būdą\npasitikrinti."
    },
    {
      "start": 4.5,
      "end": 8.72,
      "text": "Andrea pasirenka atsakymą prieš\nskaitydamas grįžtamąjį ryšį."
    },
    {
      "start": 8.72,
      "end": 12.86,
      "text": "Jei suklysta, pasinaudoja paaiškinimu, kad\npasitaisytų."
    },
    {
      "start": 12.86,
      "end": 13.62,
      "text": "Naudingas klausimas:"
    },
    {
      "start": 14.32,
      "end": 16.88,
      "text": "kodėl pataisytas atsakymas yra teisingas?"
