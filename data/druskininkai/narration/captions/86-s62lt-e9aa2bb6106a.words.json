  "cues": [
    {
      "start": 0.18,
      "end": 4.88,
      "text": "Grįžkime prie pagrindinio Andrea klausimo:\nkodėl atsakymas gali pasikeisti"
    },
    {
      "start": 4.88,
      "end": 9.1,
      "text": "nepermokius modelio? Jis užduoda trumpą,\nkonkretų klausimą."
    },
    {
      "start": 9.94,
      "end": 13.26,
      "text": "Tada palygina paaiškinimą ir jo nuorodas\nsu vadovėliu."
    },
    {
      "start": 13.72,
      "end": 16.62,
      "text": "Taip gauna atsakymą, kurį galima\nnuosekliai patikrinti."
    }
  ]
