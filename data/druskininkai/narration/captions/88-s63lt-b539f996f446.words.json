  "cues": [
    {
      "start": 0.56,
      "end": 4.84,
      "text": "Norėdamas patikrinti atsakymą, Andrea\natveria citatą ir perskaito ištrauką."
    },
    {
      "start": 6.04,
      "end": 11.24,
      "text": "Čia svarbūs žodžiai įprastas išvedimas:\njie apibūdina sąlygas, kuriomis modelio"
    },
    {
      "start": 11.24,
      "end": 16.6,
      "text": "parametrai lieka fiksuoti. Jis tikrina, ar\ništrauka pagrindžia tikslų atsakyme"
    },
    {
      "start": 16.6,
      "end": 17.5,
      "text": "pateiktą teiginį."
    }
  ]
