  "cues": [
    {
      "start": 0.32,
      "end": 2.26,
      "text": "Toliau Andrea gali pasitikrinti supratimą."
    },
    {
      "start": 3.46,
      "end": 6.84,
      "text": "Testas ar trūkstamų žodžių užduotis\ntikrina konkrečius dalykus."
    },
    {
      "start": 7.7,
      "end": 12.22,
      "text": "Užduočių lapas prašo rašytinio\npaaiškinimo, o atvejo analizė pateikia"
    },
    {
      "start": 12.22,
      "end": 18.04,
      "text": "naują pavyzdį. Kaskart jis pirmiausia\natsako, tada perskaito grįžtamąjį ryšį ir"
    },
    {
      "start": 18.04,
      "end": 19.02,
      "text": "paaiškina pataisymą."
    }
  ]
