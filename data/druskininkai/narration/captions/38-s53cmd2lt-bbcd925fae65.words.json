  "cues": [
    {
      "start": 0.24,
      "end": 4.08,
      "text": "Išmokęs terminus, Andrea turi susieti\nidėjas."
    },
    {
      "start": 4.08,
      "end": 9.1,
      "text": "Jis gali sudaryti sąvokų žemėlapį, susieti\napibrėžtis ar klasifikuoti pavyzdžius."
    },
    {
      "start": 10.18,
      "end": 13.76,
      "text": "Žodinė praktika skatina paaiškinti tuos\nryšius savais žodžiais."
    },
    {
      "start": 14.56,
      "end": 18.66,
      "text": "Kiekvienoje veikloje jis tikrina savo\nsamprotavimą pagal vadovėlį."
    }
  ]
