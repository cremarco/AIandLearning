  "cues": [
    {
      "start": 0.14,
      "end": 4.58,
      "text": "Kad pasirinktume tinkamiausią pradžią,\nužduosiu tris klausimus."
    },
    {
      "start": 4.58,
      "end": 7.2,
      "text": "Jeigu atsakymas yra taip, prašau pakelti\nranką."
    },
    {
      "start": 8.16,
      "end": 8.86,
      "text": "Pirmiausia,"
    },
    {
      "start": 9.0,
      "end": 13.3,
      "text": "ar turite ChatGPT, Gemini arba Claude\npaskyrą?"
    },
    {
      "start": 13.3,
      "end": 18.7,
      "text": "Ar jau naudojate generatyvinį DI mokymuisi\narba mokymo medžiagai rengti?"
    },
    {
      "start": 18.74,
      "end": 19.44,
      "text": "Galiausiai,"
    },
    {
      "start": 19.6,
      "end": 23.12,
      "text": "ar pažįstate Gemini Notebook (anksčiau –\nNotebookLM)?"
    },
    {
      "start": 23.9,
      "end": 24.6,
      "text": "Ačiū."
    },
    {
      "start": 24.72,
      "end": 25.9,
      "text": "Naudosime parengtus pavyzdžius,"
    },
    {
      "start": 26.42,
      "end": 30.1,
      "text": "todėl galėsite sekti pristatymą net jei\nšios priemonės jums naujos."
    }
  ]
