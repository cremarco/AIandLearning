  "cues": [
    {
      "start": 0.16,
      "end": 1.1,
      "text": "Vadovėlis jau parengtas."
    },
    {
      "start": 1.92,
      "end": 3.28,
      "text": "Kodėl renkamės šias priemones?"
    },
    {
      "start": 4.16,
      "end": 8.92,
      "text": "ChatGPT, Gemini ir Claude yra alternatyvos\n– galite pasirinkti vieną."
    },
    {
      "start": 9.54,
      "end": 13.76,
      "text": "Gemini Notebook suteikia darbo aplinką\npasirinktiems šaltiniams."
    },
    {
      "start": 13.76,
      "end": 15.92,
      "text": "Mokamos prieigos prie visų jų nereikia."
    },
    {
      "start": 17.22,
      "end": 22.14,
      "text": "Šie keturi aspektai leidžia palyginti tokį\nmetodą su atskiroms mokymosi užduotims"
    },
    {
      "start": 22.36,
      "end": 23.06,
      "text": "skirtomis priemonėmis."
    },
    {
      "start": 24.16,
      "end": 27.06,
      "text": "Pirma, jos suteikia daugiau kontrolės."
    },
    {
      "start": 27.06,
      "end": 31.24,
      "text": "Pagal savo tikslą galime paprašyti\npaprastesnio paaiškinimo arba vieno"
    },
    {
      "start": 31.24,
      "end": 36.5,
      "text": "klausimo vienu metu. Antra, galime\nsujungti mokymosi užduotis."
    },
    {
      "start": 36.5,
      "end": 40.38,
      "text": "Tą patį vadovėlį galime naudoti\npaaiškinimams, schemoms ir praktikai,"
    },
    {
      "start": 41.02,
      "end": 43.76,
      "text": "tikrindami kiekvieną rezultatą."
    },
    {
      "start": 43.76,
      "end": 47.08,
      "text": "Trečia, laviname kitur pritaikomus\nįgūdžius."
    },
    {
      "start": 47.1,
      "end": 50.64,
      "text": "Tikslų nustatymas ir atsakymų tikrinimas\npadeda ir kituose dalykuose."
    },
    {
      "start": 52.42,
      "end": 56.36,
      "text": "Galiausiai galime sutaupyti. Vienas\nasistentas gali patenkinti kelis"
    },
    {
      "start": 56.36,
      "end": 57.06,
      "text": "poreikius,"
    },
    {
      "start": 57.34,
      "end": 59.28,
      "text": "nors nemokama prieiga turi ribojimų."
    },
    {
      "start": 59.78,
      "end": 62.98,
      "text": "Prireikus galime pridėti specializuotą\npriemonę."
    },
    {
      "start": 62.98,
      "end": 64.22,
      "text": "Pradėkime nuo ChatGPT."
    }
  ]
}
