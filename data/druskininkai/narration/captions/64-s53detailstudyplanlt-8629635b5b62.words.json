  "cues": [
    {
      "start": 0.12,
      "end": 3.52,
      "text": "Atsakymai padeda Andrea nuspręsti, ko\nmokytis toliau."
    },
    {
      "start": 4.44,
      "end": 7.06,
      "text": "Šis planas suskaido tikslą į mažesnes\nveiklas."
    },
    {
      "start": 7.84,
      "end": 10.56,
      "text": "Jis gali pažymėti pažangą ir pereiti tarp\nžingsnių."
    },
    {
      "start": 11.38,
      "end": 15.88,
      "text": "Po kiekvienos veiklos pasitikrina, ką gali\npaaiškinti arba atlikti pats."
    }
  ]
