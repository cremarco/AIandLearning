  "cues": [
    {
      "start": 0.12,
      "end": 4.1,
      "text": "Pradedame nuo pagal vadovėlį sukurtų\nkortelių."
    },
    {
      "start": 4.22,
      "end": 8.86,
      "text": "Andrea atsako iš atminties, atveria\npaaiškinimą ir įsivertina prisiminimą."
    },
    {
      "start": 9.48,
      "end": 12.84,
      "text": "Įvertinęs jis pereina prie kitos kortelės."
    },
    {
      "start": 12.84,
      "end": 17.64,
      "text": "Dešimt klausimų ir atsakymų jis gali\natsisiųsti kaip CSV failą, kad vėliau"
    },
    {
      "start": 17.64,
      "end": 18.34,
      "text": "galėtų kartoti."
    }
  ]
