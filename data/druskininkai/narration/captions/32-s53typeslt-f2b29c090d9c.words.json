  "cues": [
    {
      "start": 0.14,
      "end": 2.72,
      "text": "Užklausos trumpinys įvardija norimą\nveiklą."
    },
    {
      "start": 3.6,
      "end": 5.92,
      "text": "Pirmiausia įvardykite veiklą."
    },
    {
      "start": 5.92,
      "end": 9.1,
      "text": "Pavyzdžiui, /quiz prašo klausimų,"
    },
    {
      "start": 10.12,
      "end": 13.3,
      "text": "o /conceptmap – ryšių tarp idėjų."
    },
    {
      "start": 14.26,
      "end": 15.68,
      "text": "Tada aprašykite, ko reikia:"
    },
    {
      "start": 16.24,
      "end": 20.18,
      "text": "šaltinį, mokymosi tikslą ir rezultato\nformatą."
    },
    {
      "start": 20.18,
      "end": 24.78,
      "text": "Taip pat galime paprašyti užuominų,\ngrįžtamojo ryšio ar mygtukų."
    },
    {
      "start": 24.78,
      "end": 27.62,
      "text": "Andrea vis tiek tikrina rezultatą pagal\nvadovėlį."
    }
  ]
}
