    {
      "start": 0.66,
      "end": 3.56,
      "text": "Naudodami ChatGPT, pradedame nuo Andrea\nporeikio."
    },
    {
      "start": 5.06,
      "end": 9.86,
      "text": "Ar jam reikia suprasti idėją, sudaryti\nžemėlapį, ar pasipraktikuoti atsakyti?"
    },
    {
      "start": 10.98,
      "end": 16.04,
      "text": "Priemonė gali parengti medžiagą, tačiau\nAndrea vis tiek turi pats paaiškinti arba"
    },
    {
      "start": 16.04,
      "end": 16.96,
      "text": "patobulinti atsakymą."
    },
    {
      "start": 17.82,
      "end": 19.6,
      "text": "Pažiūrėkime, kaip to paprašyti."
