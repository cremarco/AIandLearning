  "cues": [
    {
      "start": 0.1,
      "end": 5.74,
      "text": "Panagrinėkime konkretų pavyzdį – Andrea,\nuniversiteto informatikos studentą."
    },
    {
      "start": 5.74,
      "end": 10.12,
      "text": "Jis moka programuoti, tačiau vis dar\npainioja kai kurias generatyvinio DI"
    },
    {
      "start": 10.12,
      "end": 14.34,
      "text": "idėjas. Jam reikia išstudijuoti vadovėlį\nir paaiškinti,"
    },
    {
      "start": 14.94,
      "end": 18.0,
      "text": "kaip kalbos modelis kuria tekstą."
    },
    {
      "start": 18.0,
      "end": 19.64,
      "text": "Stebėdami jo darbą pagalvokite,"
    },
    {
      "start": 20.12,
      "end": 24.22,
      "text": "kaip pritaikytumėte pagalbą savo mokinių\namžiui ir mokomajam dalykui."
    }
  ]
