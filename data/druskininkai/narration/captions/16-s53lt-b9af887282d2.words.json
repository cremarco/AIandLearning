  "cues": [
    {
      "start": 0.12,
      "end": 3.96,
      "text": "Šiam bandymui Andrea reikia puikios\nknygos."
    },
    {
      "start": 3.96,
      "end": 9.72,
      "text": "Žinoma, juokauju. Tai seminarui sukurta\nišgalvota knyga, kurioje pateikti tikri"
    },
    {
      "start": 9.72,
      "end": 12.44,
      "text": "paaiškinimai ir techniniai šaltiniai."
    },
    {
      "start": 12.44,
      "end": 14.22,
      "text": "Demonstracijoms naudosiu šią knygą."
    },
    {
      "start": 14.92,
      "end": 18.04,
      "text": "Tą patį metodą galima pritaikyti kitų\ndalykų šaltiniams."
    }
  ]
