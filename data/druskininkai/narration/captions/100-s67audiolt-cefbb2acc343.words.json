  "cues": [
    {
      "start": 0.48,
      "end": 4.54,
      "text": "Audio Overview sukuria tinklalaidės\nstiliaus pokalbį tarp dviejų DI"
    },
    {
      "start": 4.54,
      "end": 5.76,
      "text": "sugeneruotų vedėjų,"
    },
    {
      "start": 6.54,
      "end": 11.54,
      "text": "pagrįstą pasirinktais šaltiniais. Jų\nklausimai ir pavyzdžiai gali padėti Andrea"
    },
    {
      "start": 11.54,
      "end": 14.06,
      "text": "sekti samprotavimą ir susieti idėjas."
    },
    {
      "start": 14.92,
      "end": 19.62,
      "text": "Pasiklausykime ir sustokime: kaip\npaaiškintumėte šią idėją savais žodžiais?"
    },
    {
      "start": 20.6,
      "end": 23.52,
      "text": "Andrea patikrina savo paaiškinimą pagal\nvadovėlį."
    }
  ]
}
