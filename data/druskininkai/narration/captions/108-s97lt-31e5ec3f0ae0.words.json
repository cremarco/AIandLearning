  "cues": [
    {
      "start": 0.14,
      "end": 4.6,
      "text": "Kad po šio susitikimo būtų lengviau\npasirinkti priemones, šiose lentelėse jos"
    },
    {
      "start": 4.6,
      "end": 9.54,
      "text": "sugrupuotos pagal paskirtį. Pradedame nuo\nnemokamų priemonių."
    },
    {
      "start": 9.54,
      "end": 13.96,
      "text": "Pasirinkite reikalingą funkciją ir\npatikrinkite prieigos sąlygas."
    },
    {
      "start": 13.96,
      "end": 18.4,
      "text": "Kai kuriems nemokamiems planams vis tiek\nreikia paskyros arba taikomi ribojimai,"
    },
    {
      "start": 18.8,
      "end": 20.56,
      "text": "todėl turėkite parengtą alternatyvą."
    }
  ]
}
