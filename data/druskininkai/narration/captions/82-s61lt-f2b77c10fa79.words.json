  "cues": [
    {
      "start": 0.0,
      "end": 3.42,
      "text": "Pradedame nuo vadovėlio pridėjimo."
    },
    {
      "start": 3.46,
      "end": 8.2,
      "text": "Andrea patikrina importuotą tekstą ir\npasirenka savo klausimo šaltinius."
    },
    {
      "start": 8.2,
      "end": 12.68,
      "text": "Tai padeda apriboti užduotį, tačiau\natsakyme vis tiek gali būti klaidų."
    },
    {
      "start": 13.38,
      "end": 15.3,
      "text": "Jį reikės patikrinti pagal vadovėlį."
    }
  ]
