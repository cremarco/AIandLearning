    {
      "start": 0.36,
      "end": 5.84,
      "text": "Gemini Notebook yra Google DI priemonė,\nskirta mokymuisi ir supratimui."
    },
    {
      "start": 5.84,
      "end": 8.36,
      "text": "Ji padeda nagrinėti jūsų pasirinktus\nšaltinius:"
    },
    {
      "start": 8.88,
      "end": 12.88,
      "text": "galite užduoti klausimus, susieti idėjas\nir kurti mokymosi medžiagą."
    },
    {
      "start": 13.7,
      "end": 18.18,
      "text": "Naudosime ją su Andrea vadovėliu ir\ntikrinsime atsakymus pagal originalų"
    },
    {
      "start": 18.18,
      "end": 18.72,
      "text": "tekstą."
    }
