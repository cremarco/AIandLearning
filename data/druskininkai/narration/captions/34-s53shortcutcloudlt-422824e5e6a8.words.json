  "cues": [
    {
      "start": 0.2,
      "end": 3.72,
      "text": "Dabar panagrinėkime 15 užklausų pavyzdžių."
    },
    {
      "start": 3.72,
      "end": 8.14,
      "text": "Kiekvienas jų padeda atlikti mokymosi\nveiksmą, pavyzdžiui, prisiminti,"
    },
    {
      "start": 8.44,
      "end": 9.66,
      "text": "paaiškinti ar planuoti."
    },
    {
      "start": 11.02,
      "end": 15.38,
      "text": "Galite pasirinkti žymenį, perskaityti jo\npaskirtį ir atverti įrašą."
    },
    {
      "start": 16.78,
      "end": 18.06,
      "text": "Stebėdami pagalvokite,"
    },
    {
      "start": 18.58,
      "end": 21.8,
      "text": "kuri veikla padėtų Andrea įveikti\ndabartinį sunkumą."
    }
  ]
