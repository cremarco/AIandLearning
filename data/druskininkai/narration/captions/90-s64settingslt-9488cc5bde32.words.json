  "cues": [
    {
      "start": 0.2,
      "end": 3.64,
      "text": "Taip pat galime pakeisti pokalbio eigą."
    },
    {
      "start": 3.76,
      "end": 6.46,
      "text": "Learning Guide yra Gemini Notebook\npokalbio režimas,"
    },
    {
      "start": 7.1,
      "end": 9.72,
      "text": "skirtas mokytis pagal savo šaltinius."
    },
    {
      "start": 9.72,
      "end": 14.28,
      "text": "Jis užduoda atvirus klausimus, suskaido\nproblemas į mažesnius žingsnius ir"
    },
    {
      "start": 14.28,
      "end": 17.2,
      "text": "pritaiko paaiškinimus besimokančiajam."
    },
    {
      "start": 17.2,
      "end": 22.0,
      "text": "Pasirenkame šį režimą ir nustatome\natsakymo ilgį, kad Andrea turėtų erdvės"
    },
    {
      "start": 22.0,
      "end": 27.46,
      "text": "pagalvoti ir atsakyti. Mokytojas gali\nnustatyti aiškų kriterijų ir nuspręsti,"
    },
    {
      "start": 27.84,
      "end": 31.06,
      "text": "kada tinkama užuomina, o kada –\nsavarankiškas bandymas."
    },
    {
      "start": 32.1,
      "end": 36.0,
      "text": "Andrea remiasi grįžtamuoju ryšiu\npasirinkdamas, ką praktikuoti toliau."
    }
  ]
