    {
      "start": 0.1,
      "end": 4.42,
      "text": "Šiame įraše matome Gemini Notebook\nfunkciją Quiz."
    },
    {
      "start": 4.54,
      "end": 8.0,
      "text": "Andrea atsako prieš atverdamas užuominą ar\ngrįžtamąjį ryšį."
    },
    {
      "start": 8.72,
      "end": 12.3,
      "text": "Pirmuoju bandymu jis teisingai atsako į\npenkis iš šešių klausimų,"
    },
    {
      "start": 12.9,
      "end": 16.36,
      "text": "tada dar kartą bando atsakyti į praleistą\nklausimą."
    },
    {
      "start": 16.36,
      "end": 21.08,
      "text": "Kitas žingsnis – paaiškinti pataisymą ir\npasitikrinti supratimą nauju pavyzdžiu."
    }
  ]
