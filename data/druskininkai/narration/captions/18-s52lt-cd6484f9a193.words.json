  "cues": [
    {
      "start": 0.42,
      "end": 4.48,
      "text": "Andrea turi suprasti vadovėlį ir parodyti,\nką išmoko."
    },
    {
      "start": 4.48,
      "end": 7.38,
      "text": "Stebėsime keturias susijusias veiklas."
    },
    {
      "start": 7.38,
      "end": 10.62,
      "text": "Pirmiausia jis skaito vadovėlį ir\npasižymi, kas neaišku."
    },
    {
      "start": 11.7,
      "end": 15.2,
      "text": "Tada jis pavaizduoja idėjas schemoje ir\npaaiškina jų ryšius."
    },
    {
      "start": 15.98,
      "end": 21.68,
      "text": "Toliau jis tikrina schemą ir DI pasiūlymus\npagal vadovėlį bei ištaiso klaidas."
    },
    {
      "start": 22.08,
      "end": 24.46,
      "text": "Galiausiai jis paaiškina naują pavyzdį\nsavais žodžiais,"
    },
    {
      "start": 25.16,
      "end": 29.8,
      "text": "be DI. Jo schema, paaiškinimas ir\npataisymai parodo, ką jis supranta."
    }
  ]
