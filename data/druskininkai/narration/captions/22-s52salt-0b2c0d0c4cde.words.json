  "cues": [
    {
      "start": 0.08,
      "end": 4.56,
      "text": "Tačiau kaip Andrea sužino, ar jo\npasirinkimai veiksmingi?"
    },
    {
      "start": 4.56,
      "end": 9.32,
      "text": "Per įsivertinimą: jis tikrina savo darbą\npagal aiškius kriterijus."
    },
    {
      "start": 9.32,
      "end": 10.02,
      "text": "Pavyzdžiui,"
    },
    {
      "start": 10.16,
      "end": 15.34,
      "text": "jis gali paaiškinti idėjas, bet jam sunku\natskleisti jų ryšius, todėl jis patobulina"
    },
    {
      "start": 15.34,
      "end": 21.34,
      "text": "savo žemėlapį. DI gali pateikti grįžtamąjį\nryšį, tačiau Andrea nusprendžia, ką"
    },
    {
      "start": 21.34,
      "end": 22.26,
      "text": "dar reikia tobulinti."
    }
  ]
