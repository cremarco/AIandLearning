    {
      "start": 0.12,
      "end": 4.36,
      "text": "Pirmoji grupė padeda Andrea prisiminti ir\npakartoti."
    },
    {
      "start": 4.36,
      "end": 9.22,
      "text": "Naudodamas /flashcard, jis atsako prieš\natverdamas paaiškinimą."
    },
    {
      "start": 10.5,
      "end": 15.62,
      "text": "Naudodamas /mistakelog, jis fiksuoja\nklaidas ir pataisymus."
    },
    {
      "start": 15.62,
      "end": 19.6,
      "text": "Kartu šios veiklos padeda pasirinkti, ką\nmokytis dar kartą."
    }
