  "cues": [
    {
      "start": 0.06,
      "end": 4.9,
      "text": "Kai kurios priemonės suteikia daugiau\nfunkcijų pasirinkus mokamą planą."
    },
    {
      "start": 4.9,
      "end": 9.52,
      "text": "Prieš mokėdami palyginkite reikiamą\nfunkciją su nemokama alternatyva ir"
    },
    {
      "start": 9.52,
      "end": 11.18,
      "text": "patikrinkite galiojančias sąlygas."
    },
    {
      "start": 12.24,
      "end": 17.16,
      "text": "Mokama priemonė naudinga tik tada, kai\npapildoma funkcija padeda atlikti jūsų"
    },
    {
      "start": 17.16,
      "end": 17.86,
      "text": "užduotį."
    }
  ]
