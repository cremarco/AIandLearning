  "cues": [
    {
      "start": 0.04,
      "end": 3.54,
      "text": "Kai kurios klaidos susijusios su idėjų\nryšiais."
    },
    {
      "start": 3.54,
      "end": 9.24,
      "text": "Šis sąvokų žemėlapis sieja modelio mokymą,\nišvedimą ir RAG."
    },
    {
      "start": 9.46,
      "end": 14.06,
      "text": "Pagrindiniai klausimai: kada keičiasi\nparametrai ir kada informacija įtraukiama"
    },
    {
      "start": 14.06,
      "end": 17.12,
      "text": "į kontekstą? Andrea paaiškina kiekvieną\nryšį,"
    },
    {
      "start": 17.6,
      "end": 21.16,
      "text": "patikrina vadovėlį ir prireikus pataiso\natsakymą."
    },
    {
      "start": 21.16,
      "end": 25.3,
      "text": "Jo paaiškinimas padeda mokytojui\npasirinkti klausimą ar užuominą kitam"
    },
    {
      "start": 25.3,
      "end": 26.0,
      "text": "bandymui."
    }
  ]
