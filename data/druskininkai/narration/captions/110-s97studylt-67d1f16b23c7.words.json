  "cues": [
    {
      "start": 0.08,
      "end": 3.92,
      "text": "Žemėlapiams ir kartojimui turime daugiau\nspecializuotų pasirinkimų."
    },
    {
      "start": 4.8,
      "end": 9.62,
      "text": "Piešimo priemonės padeda paaiškinti\nryšius, o kartojimo priemonės – po kurio"
    },
    {
      "start": 9.62,
      "end": 11.68,
      "text": "laiko grįžti prie klausimų."
    },
    {
      "start": 11.68,
      "end": 15.46,
      "text": "Pasirinkite mokymosi poreikį atitinkantį\nveiksmą."
    },
    {
      "start": 15.46,
      "end": 18.88,
      "text": "Galime toliau naudoti tą patį šaltinį ir\ntikrinimo būdus."
    }
  ]
}
