  "cues": [
    {
      "start": 0.08,
      "end": 2.5,
      "text": "Taip pat turime atsižvelgti į prieinamumą."
    },
    {
      "start": 3.48,
      "end": 7.92,
      "text": "Skaitymas balsu ir diktavimas gali padėti\nįvairiuose mokymosi etapuose."
    },
    {
      "start": 9.2,
      "end": 11.56,
      "text": "Pagalbos priemonę rinkitės kartu su\nbesimokančiuoju."
    },
    {
      "start": 12.52,
      "end": 17.02,
      "text": "Patikrinkite prieinamas kalbas ir\nperžiūrėkite padiktuotą tekstą."
    },
    {
      "start": 17.1,
      "end": 21.08,
      "text": "Read&Write siūlo platesnį priemonių\nrinkinį, kuriam reikalinga licencija."
    }
  ]
