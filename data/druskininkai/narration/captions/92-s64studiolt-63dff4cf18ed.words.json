    {
      "start": 0.48,
      "end": 4.98,
      "text": "Studio skydelyje pateikti formatai,\nkuriuos Gemini Notebook gali sugeneruoti"
    },
    {
      "start": 5.04,
      "end": 10.16,
      "text": "iš pasirinktų šaltinių. Galime kurti\ngarsą, vaizdą, žemėlapius,"
    },
    {
      "start": 10.68,
      "end": 12.64,
      "text": "mokymosi medžiagą ir vaizdines santraukas."
    },
    {
      "start": 13.96,
      "end": 17.34,
      "text": "Pasirinkite mokymosi tikslą atitinkantį\nformatą."
    },
    {
      "start": 17.34,
      "end": 18.36,
      "text": "Pažiūrėkime kelis pavyzdžius."
